% Стандартная библиотека: списки.
%
% Подключение:  prologd -I stdlib -s программа.pld  и в программе
%   :- ИМПОРТ("lists.pld").
% В окне папку указывают один раз: «Правка → Настройки… → Выполнение →
% Дополнительные каталоги ИМПОРТ».
%
% Имена предикатов латинские, как в первой библиотеке Пролог-Д, имена аргументов
% русские.  Встроенные имена заняты: first/2 — это встроенный ПЕРВОЕ, поэтому
% первый элемент списка достаёт head/2. Рядом лежат sets.pld (множества на
% списках) и sorts.pld (приёмы сортировки).

% Принадлежность элемента списку: member(Элемент, Список)
member(Элемент, [Элемент|_]).
member(Элемент, [_|Хвост]):-member(Элемент, Хвост).

% Длина списка: length(Список, Длина)
length([], 0).
length([_|Хвост], Длина):-length(Хвост, Часть), Длина = #Часть + 1#.

% Первый элемент списка: head(Список, Элемент)
head([Элемент|_], Элемент).

% Последний элемент списка: last(Список, Элемент)
last([Элемент], Элемент).
last([_|Хвост], Элемент):-last(Хвост, Элемент).

% Два соседних элемента: adjacent(Список, Первый, Второй)
adjacent([Первый, Второй|_], Первый, Второй).
adjacent([_|Хвост], Первый, Второй):-adjacent(Хвост, Первый, Второй).

% Минимальный элемент списка: min_list(Список, Минимум)
min_list([Элемент], Элемент).
min_list([Первый|Хвост], Минимум):-min_list(Хвост, МинимумХвоста),
	ПЕРВОЕ((МЕНЬШЕ(МинимумХвоста, Первый), Минимум = МинимумХвоста), Минимум = Первый).

% Максимальный элемент списка: max_list(Список, Максимум)
max_list([Элемент], Элемент).
max_list([Первый|Хвост], Максимум):-max_list(Хвост, МаксимумХвоста),
	ПЕРВОЕ((БОЛЬШЕ(МаксимумХвоста, Первый), Максимум = МаксимумХвоста), Максимум = Первый).

% Конкатенация списков: append(Первый, Второй, Итог)
append([], Второй, Второй).
append([Голова|Хвост], Второй, [Голова|Итог]):-append(Хвост, Второй, Итог).

% Обращение списка: reverse(Список, Обратный); reverse/3 — та же работа с накопителем
reverse(Список, Обратный):-reverse(Список, [], Обратный).
reverse([], Обратный, Обратный).
reverse([Голова|Хвост], Накопитель, Обратный):-
	reverse(Хвост, [Голова|Накопитель], Обратный).

% Линеаризация: элементы вложенных списков идут подряд, в порядке обхода.
% Форма с тремя аргументами — разностный список: обход за один проход, без
% склеивания частей на каждом шаге.  Последнее предложение берёт только то, что
% списком не является: без проверки СПИСОК/1 оно подходило бы и к списку, и
% линеаризация давала бы лишние решения.
flatten(Список, Плоский):-flatten(Список, Плоский, []).
flatten([], Хвост, Хвост).
flatten([Голова|Хвост], Плоский, Накопитель):-
	flatten(Голова, Плоский, Середина), flatten(Хвост, Середина, Накопитель).
flatten(Элемент, [Элемент|Хвост], Хвост):-НЕ(СПИСОК(Элемент)).

% Удаление первого вхождения: delete(Список, Элемент, Остаток)
delete([Элемент|Хвост], Элемент, Хвост):-!.
delete([Голова|Хвост], Элемент, [Голова|Остаток]):-
	delete(Хвост, Элемент, Остаток).

% Удаление всех вхождений: delete_all(Список, Элемент, Остаток)
delete_all([], _, []).
delete_all([Элемент|Хвост], Элемент, Остаток):-!,
	delete_all(Хвост, Элемент, Остаток).
delete_all([Голова|Хвост], Элемент, [Голова|Остаток]):-
	delete_all(Хвост, Элемент, Остаток).

% Выбор вхождения: select(Список, Элемент, Остаток) — при возврате перебирает все
select([Элемент|Хвост], Элемент, Хвост).
select([Голова|Хвост], Элемент, [Голова|Остаток]):-
	select(Хвост, Элемент, Остаток).

% Перестановка: permutation(Список, Перестановка) — при возврате перебирает все
permutation([], []).
permutation(Список, [Первый|Остальные]):-select(Список, Первый, Часть),
	permutation(Часть, Остальные).

% Замена всех вхождений одного элемента другим: substitute(Список, Что, Чем, Итог)
substitute([], _, _, []).
substitute([Что|Хвост], Что, Чем, [Чем|Итог]):-!,
	substitute(Хвост, Что, Чем, Итог).
substitute([Голова|Хвост], Что, Чем, [Голова|Итог]):-
	substitute(Хвост, Что, Чем, Итог).

% Начало списка: prefix(Начало, Список) — Начало открывает Список
prefix([], _).
prefix([Голова|Хвост], [Голова|Остаток]):-prefix(Хвост, Остаток).

% Конец списка: suffix(Конец, Список) — Конец заканчивает Список
suffix(Список, Список).
suffix(Конец, [_|Список]):-suffix(Конец, Список).

% Подсписок из подряд идущих элементов: sublist(Кусок, Список) — при возврате
% перебирает все вхождения
sublist(Кусок, Список):-suffix(Остаток, Список), prefix(Кусок, Остаток).

% Печать элементов списка через пробел, в конце — перевод строки: print_list(Список)
print_list(Список):-print_items(Список), ПС.
print_items([]).
print_items([Элемент]):-ВЫВОД(Элемент).
print_items([Элемент|Хвост]):-ВЫВОД(Элемент, " "), print_items(Хвост).

% Чтение Сколько чисел в список, в порядке ввода: read_numbers(Сколько, Список)
read_numbers(Сколько, Список):-read_numbers(Сколько, [], Обратные),
	reverse(Обратные, Список).
read_numbers(0, Обратные, Обратные):-!.
read_numbers(Сколько, Накопитель, Список):-ВВОДЦЕЛ(Число),
	read_numbers(#Сколько - 1#, [Число|Накопитель], Список).
