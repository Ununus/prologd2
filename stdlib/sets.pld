% Стандартная библиотека: множества на списках.
%
% Предикаты над множеством:
% set, unique,  subset, unionset, intersect, difset
%
% Множество здесь - список без повторов по возрастанию: ровно то, что даёт
% встроенная СОРТИРОВКА. На входе списки могут быть любыми, на выходе всегда
% множество, поэтому у каждого предиката ровно одно решение.
%
% Подключение:  prologd -I stdlib -s программа.pld  и в программе
%   :- ИМПОРТ("sets.pld").
% Директива подключает и lists.pld - множества построены на списках.

:- ИМПОРТ("lists.pld").

% Множество из списка: set(Список, Множество) - то же, что встроенная СОРТИРОВКА,
% но с одним именем на все множества библиотеки
set(Список, Множество):-СОРТИРОВКА(Список, Множество).

% Без повторов, но порядок первых вхождений сохраняется: unique(Список, Итог).
% Форма с тремя аргументами - та же работа с накопителем.
unique(Список, Итог):-unique(Список, [], Обратные), reverse(Обратные, Итог).
unique([], Итог, Итог).
unique([Элемент|Хвост], Виденные, Итог):-member(Элемент, Виденные), !,
	unique(Хвост, Виденные, Итог).
unique([Элемент|Хвост], Виденные, Итог):-
	unique(Хвост, [Элемент|Виденные], Итог).

% Подмножество: subset(Меньшее, Большее) - каждый элемент первого есть во втором
subset([], _).
subset([Элемент|Хвост], Множество):-member(Элемент, Множество),
	subset(Хвост, Множество).

% Равенство множеств: equalset(Первый, Второй)
equalset(Первый, Второй):-subset(Первый, Второй), subset(Второй, Первый).

% Объединение: unionset(Первый, Второй, Итог)
unionset(Первый, Второй, Итог):-append(Первый, Второй, Все), set(Все, Итог).

% Пересечение: intersect(Первый, Второй, Итог)
intersect(Первый, Второй, Итог):-НАЙТИВСЕ(Элемент,
	(member(Элемент, Первый), member(Элемент, Второй)), Все), set(Все, Итог).

% Разность: difset(Первый, Второй, Итог) - элементы первого, которых нет во втором
difset(Первый, Второй, Итог):-НАЙТИВСЕ(Элемент,
	(member(Элемент, Первый), НЕ(member(Элемент, Второй))), Все), set(Все, Итог).
