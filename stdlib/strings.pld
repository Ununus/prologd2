% Стандартная библиотека: строки.
%
% Предикаты над строками:
% trim, trim_left, trim_right, words, rest_after,
% join, replace, to_number, to_numbers
%
% Строка - это символьная константа в двойных кавычках; позиции в ней считаются с
% единицы, как у встроенной КОПИЯ/4. Разбор написан через встроенные СЦЕП
% (обратимая конкатенация) и КОПИЯ, поэтому читается как определение.
% арифметика над байтами.
%
% Подключение:  prologu -I stdlib -s программа.pld  и в программе
%   :- ИМПОРТ("strings.pld").
% Директива подключает и lists.pld - разбор строк возвращает списки.

:- ИМПОРТ("lists.pld").

% Строка без пробелов с обоих концов: trim(Строка, Обрезанная)
trim(Строка, Обрезанная):-trim_left(Строка, Слева),
	trim_right(Слева, Обрезанная).

% Строка без пробелов слева: trim_left(Строка, Обрезанная)
trim_left(Строка, Обрезанная):-СЦЕП(" ", Остаток, Строка), !,
	trim_left(Остаток, Обрезанная).
trim_left(Строка, Строка).

% Строка без пробелов справа: trim_right(Строка, Обрезанная)
trim_right(Строка, Обрезанная):-СЦЕП(Начало, " ", Строка), !,
	trim_right(Начало, Обрезанная).
trim_right(Строка, Строка).

% Разбор строки на слова: words(Строка, Слова). Разделители - пробелы, сколько бы
% их ни было; пустых слов не бывает, порядок слов сохраняется
words(Строка, []):-trim(Строка, ""), !.
words(Строка, [Слово|Остальные]):-trim(Строка, Обрезанная),
	КОПИЯ(Обрезанная, Позиция, 1, " "), !, До = #Позиция - 1#,
	КОПИЯ(Обрезанная, 1, До, Слово), rest_after(Обрезанная, Позиция, Остаток),
	words(Остаток, Остальные).
words(Строка, [Обрезанная]):-trim(Строка, Обрезанная).

% Остаток строки после позиции: пустая строка, если строка там кончается
rest_after(Строка, Позиция, ""):-ДЛИНА(Строка, Позиция), !.
rest_after(Строка, Позиция, Остаток):-ДЛИНА(Строка, Длина),
	Начало = #Позиция + 1#, ДлинаОстатка = #Длина - Позиция#,
	КОПИЯ(Строка, Начало, ДлинаОстатка, Остаток).

% Сборка строки из списка: join(Слова, Строка) - через один пробел;
% join(Слова, Разделитель, Строка) - с любым разделителем. Слова - текстовые
% константы (число в списке - ошибка типа, как и у самой СЦЕП). Форма с четырьмя
% аргументами - та же работа с накопителем.
join(Слова, Строка):-join(Слова, " ", Строка).
join(Слова, Разделитель, Строка):-join(Слова, Разделитель, "", Строка).
join([], _, Собранная, Собранная).
join([Слово], _, Собранная, Строка):-!, СЦЕП(Собранная, Слово, Строка).
join([Слово|Остальные], Разделитель, Собранная, Строка):-
	СЦЕП(Собранная, Слово, СловоИРазделитель),
	СЦЕП(СловоИРазделитель, Разделитель, Следующая),
	join(Остальные, Разделитель, Следующая, Строка).

% Замена всех вхождений подстроки: replace(Строка, Что, Чем, Результат). Что -
% непустая строка. Форма с пятью аргументами - та же работа с накопителем.
replace(Строка, Что, Чем, Результат):-replace(Строка, Что, Чем, "", Результат).
replace("", _, _, Собранная, Собранная):-!.
replace(Строка, Что, Чем, Собранная, Результат):-
	КОПИЯ(Строка, Позиция, Длина, Что), !, До = #Позиция - 1#,
	КОПИЯ(Строка, 1, До, Начало), СЦЕП(Собранная, Начало, СНачалом),
	СЦЕП(СНачалом, Чем, СЗаменой), Конец = #Позиция + Длина - 1#,
	rest_after(Строка, Конец, Остаток),
	replace(Остаток, Что, Чем, СЗаменой, Результат).
replace(Строка, _, _, Собранная, Результат):-СЦЕП(Собранная, Строка, Результат).

% Число из строки: to_number(Строка, Число) - целое или вещественное, иначе
% неудача. СИМВ/1 отсекает всё, что не текст: без этой проверки СТРЦЕЛ получил бы
% не тот аргумент и выдал ошибку типа вместо неудачи.
to_number(Строка, Число):-СИМВ(Строка), ПЕРВОЕ(СТРЦЕЛ(Строка, Число),
	СТРВЕЩ(Строка, Число)).

% Числа среди строк: to_numbers(Строки, Числа) - что числом не является,
% пропускается (строка может быть фразой). Форма с тремя аргументами - та же
% работа с накопителем.
to_numbers(Строки, Числа):-to_numbers(Строки, [], Обратные),
	reverse(Обратные, Числа).
to_numbers([], Числа, Числа).
to_numbers([Строка|Остальные], Накопитель, Числа):-ПЕРВОЕ((to_number(Строка, Число), to_numbers(Остальные, [Число|Накопитель], Числа)),
	       to_numbers(Остальные, Накопитель, Числа)).

% Чтение строки и разбор её на слова: read_words(Слова)
read_words(Слова):-ВВОДСТР(Строка), words(Строка, Слова).
