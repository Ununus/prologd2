% Стандартная библиотека: целые числа.
%
% Предикаты над встроенной арифметикой:
% gcd, lcm, power, factorial, is_prime, has_divisor, primes
%
% Подключение:  prologd -I stdlib -s программа.pld  и в программе
%   :- ИМПОРТ("math.pld").
%
% Директива подключает iso.pld: between/3, здесь на нём построены primes/2.

:- ИМПОРТ("iso.pld").

% Наибольший общий делитель: gcd(А, Б, НОД) - алгоритм Евклида, знаки не важны
gcd(А, Б, НОД):-ABS(А, МодульА), ABS(Б, МодульБ), gcd_of(МодульА, МодульБ, НОД).

% gcd_of(А, Б, НОД) - тот же алгоритм для неотрицательных чисел
gcd_of(А, 0, А):-!.
gcd_of(А, Б, НОД):-Остаток = #А mod Б#, gcd_of(Б, Остаток, НОД).

% Наименьшее общее кратное: lcm(А, Б, НОК) - нуль, если хоть одно из чисел нуль
lcm(_, 0, 0):-!.
lcm(А, Б, НОК):-gcd(А, Б, НОД), Произведение = #А * Б#,
	Частное = #Произведение div НОД#, ABS(Частное, НОК).

% Возведение в степень: power(Основание, Показатель, Результат) - Показатель не
% меньше нуля; за один проход, потому что показатель делится пополам
power(_, 0, 1).
power(Основание, Показатель, Результат):-БОЛЬШЕ(Показатель, 0),
	Половина = #Показатель div 2#, Остаток = #Показатель mod 2#,
	power(Основание, Половина, Часть), Квадрат = #Часть * Часть#, ПЕРВОЕ((РАВНО(Остаток, 0), Результат = Квадрат),
	       (Результат = #Квадрат * Основание#)).

% Факториал: factorial(Число, Факториал); форма с тремя аргументами - та же работа
% с накопителем
factorial(Число, Факториал):-factorial(Число, 1, Факториал).
factorial(0, Накопленное, Накопленное):-!.
factorial(Число, Накопленное, Факториал):-Следующее = #Накопленное * Число#,
	Предыдущее = #Число - 1#, factorial(Предыдущее, Следующее, Факториал).

% Проверка простоты: is_prime(Число) - истинно для простых чисел
is_prime(Число):-БОЛЬШЕ(Число, 1), НЕ(has_divisor(Число, 2)).

% has_divisor(Число, Делитель) - у Числа есть делитель от Делителя до корня
has_divisor(Число, Делитель):-Квадрат = #Делитель * Делитель#,
	НЕ(БОЛЬШЕ(Квадрат, Число)), ПЕРВОЕ((Остаток = #Число mod Делитель#, РАВНО(Остаток, 0)),
	       (Следующий = #Делитель + 1#, has_divisor(Число, Следующий))).

% Простые числа до предела: primes(Предел, Список)
primes(Предел, Список):-НАЙТИВСЕ(Число,
	(between(2, Предел, Число), is_prime(Число)), Список).
