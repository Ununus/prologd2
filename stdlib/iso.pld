% Стандартная библиотека: имена ISO.
%
% Здесь то, что программа на ISO ждёт под именами стандарта, но чего нет в самом
% языке.  Две половины: предикаты собственно стандарта (nonvar/1, number/1,
% atomic/1, compound/1, callable/1, once/1 и работа с текстом: atom_length/2,
% atom_concat/3, sub_atom/5, atom_codes/2, atom_chars/2, char_code/2,
% number_codes/2, number_chars/2) и общие библиотечные имена, которые есть в
% любой реализации, хотя стандарт их не требует (member/2, append/3, length/2,
% last/2, between/3, succ/2, ignore/1, nth1/3, memberchk/2).
%
% Чего здесь нет, хотя оно в стандарте: functor/3, arg/3, =../2 (вместо него
% ТЕРМ/2), copy_term/2, keysort/2, clause/2, abolish/1 и repeat/0.  Исключений,
% halt/1 и модулей нет во всём языке — это записано в руководстве (разделы 4.9,
% 4.10 и 8).
%
% Подключение:  prologd -I stdlib -s программа.pld  и в программе
%   :- ИМПОРТ("iso.pld").
%
% Зачем это нужно: примеры из книги, написанные на ISO, должны работать без
% правок

% Принадлежность элемента списку: member(Элемент, Список)
member(Элемент, [Элемент|_]).
member(Элемент, [_|Хвост]):-member(Элемент, Хвост).

% Длина списка: length(Список, Длина)
length([], 0).
length([_|Хвост], Длина):-length(Хвост, Часть), Длина = #Часть + 1#.

% Последний элемент списка: last(Список, Элемент)
last([Элемент], Элемент).
last([_|Хвост], Элемент):-last(Хвост, Элемент).

% Конкатенация списков: append(Первый, Второй, Итог)
append([], Второй, Второй).
append([Голова|Хвост], Второй, [Голова|Итог]):-append(Хвост, Второй, Итог).

% Целые по порядку: between(Низ, Верх, Число) - перебирает от Низа до Верха
% включительно
between(Низ, Верх, Низ):-НЕ(БОЛЬШЕ(Низ, Верх)).
between(Низ, Верх, Число):-МЕНЬШЕ(Низ, Верх), Следующее = #Низ + 1#,
	between(Следующее, Верх, Число).

% Терм уже связан: nonvar(Терм)
nonvar(Терм):-НЕ(ПЕР(Терм)).

% atom/1 и string/1 - встроенные проверки (раздел 9 руководства): атом и строка
% здесь разные виды терма, как в ISO, поэтому atom("молоко") ложно, а
% string("молоко") истинно. Обе вместе - это СИМВ/1.

% Терм - число: целое или вещественное
number(Терм):-ЦЕЛ(Терм).
number(Терм):-ВЕЩ(Терм).

% Терм - целое, вещественное или текст: то, что в ISO не делится на части
atomic(Терм):-number(Терм).
atomic(Терм):-СИМВ(Терм).

% Терм - составной: структура или список. Свободная переменная, число и текст
% составными не считаются
compound(Терм):-НЕ(ПЕР(Терм)), НЕ(СИМВ(Терм)), НЕ(ЦЕЛ(Терм)), НЕ(ВЕЩ(Терм)).

% Терм годится в цель: атом или составной. Строка целью не бывает - движок
% отвечает на неё «Цель должна быть предикатом»
callable(Терм):-atom(Терм).
callable(Терм):-compound(Терм).

% Текст в записи ISO: длина, склейка, подстрока, знаки и коды. Знак здесь -
% односимвольный атом, код - число. Ошибку типа библиотека поднять не может,
% поэтому неверный вид аргумента - неудача, а не type_error (раздел 8
% руководства по библиотеке).

% Длина атома в символах: atom_length(Атом, Длина)
atom_length(Атом, Длина):-АТОМ(Атом), ДЛИНА(Атом, Длина).

% Склейка атомов: atom_concat(Левый, Правый, Целый). Известны должны быть два из
% трёх, как в ISO; склейка идёт по строкам, потому что свободный аргумент СЦЕП
% связывает строкой, а нужен атом
atom_concat(Левый, Правый, Целый):-НЕ(ПЕР(Левый)), НЕ(ПЕР(Правый)), !,
	АТОМ(Левый), АТОМ(Правый), АТОМСТР(Левый, СЛевый), АТОМСТР(Правый, СПравый),
	СЦЕП(СЛевый, СПравый, СЦелый), АТОМСТР(Целый, СЦелый).
atom_concat(Левый, Правый, Целый):-НЕ(ПЕР(Левый)), НЕ(ПЕР(Целый)), !,
	АТОМ(Левый), АТОМ(Целый), АТОМСТР(Левый, СЛевый), АТОМСТР(Целый, СЦелый),
	СЦЕП(СЛевый, СПравый, СЦелый), АТОМСТР(Правый, СПравый).
atom_concat(Левый, Правый, Целый):-НЕ(ПЕР(Правый)), НЕ(ПЕР(Целый)), !,
	АТОМ(Правый), АТОМ(Целый), АТОМСТР(Правый, СПравый), АТОМСТР(Целый, СЦелый),
	СЦЕП(СЛевый, СПравый, СЦелый), АТОМСТР(Левый, СЛевый).

% Подстрока по позициям с нуля: sub_atom(Атом, До, Длина, После, Подстрока).
% Все подстроки перебираются на возврате - это делает ПОДСТРОКА/5
sub_atom(Атом, До, Длина, После, Подстрока):-АТОМ(Атом),
	ПОДСТРОКА(Атом, До, Длина, После, Стр), АТОМСТР(Подстрока, Стр).

% Коды символов атома: atom_codes(Атом, Коды)
atom_codes(Атом, Коды):-НЕ(ПЕР(Атом)), !, АТОМ(Атом), АТОМСТР(Атом, Стр),
	СТРСПИС(Стр, Коды).
atom_codes(Атом, Коды):-НЕ(ПЕР(Коды)), СТРСПИС(Стр, Коды), АТОМСТР(Атом, Стр).

% Знаки атома и код одного знака: atom_chars(Атом, Знаки), char_code(Знак, Код)
atom_chars(Атом, Знаки):-НЕ(ПЕР(Атом)), !, atom_codes(Атом, Коды),
	коды_в_знаки(Коды, Знаки).
atom_chars(Атом, Знаки):-НЕ(ПЕР(Знаки)), знаки_в_коды(Знаки, Коды),
	atom_codes(Атом, Коды).

char_code(Знак, Код):-НЕ(ПЕР(Знак)), !, АТОМ(Знак), АТОМСТР(Знак, Стр),
	ДЛИНА(Стр, 1), СТРСПИС(Стр, [Код]).
char_code(Знак, Код):-НЕ(ПЕР(Код)), СТРСПИС(Стр, [Код]), АТОМСТР(Знак, Стр).

коды_в_знаки([], []).
коды_в_знаки([Код|Коды], [Знак|Знаки]):-char_code(Знак, Код),
	коды_в_знаки(Коды, Знаки).

знаки_в_коды([], []).
знаки_в_коды([Знак|Знаки], [Код|Коды]):-char_code(Знак, Код),
	знаки_в_коды(Знаки, Коды).

% Запись числа: number_codes(Число, Коды) и number_chars(Число, Знаки)
number_codes(Число, Коды):-НЕ(ПЕР(Число)), !, число_текст(Число, Стр),
	СТРСПИС(Стр, Коды).
number_codes(Число, Коды):-НЕ(ПЕР(Коды)), СТРСПИС(Стр, Коды),
	текст_число(Стр, Число).

number_chars(Число, Знаки):-НЕ(ПЕР(Число)), !, number_codes(Число, Коды),
	коды_в_знаки(Коды, Знаки).
number_chars(Число, Знаки):-НЕ(ПЕР(Знаки)), знаки_в_коды(Знаки, Коды),
	number_codes(Число, Коды).

число_текст(Число, Стр):-ЦЕЛ(Число), !, СТРЦЕЛ(Стр, Число).
число_текст(Число, Стр):-ВЕЩ(Число), СТРВЕЩ(Стр, Число).

текст_число(Стр, Число):-СТРЦЕЛ(Стр, Число), !.
текст_число(Стр, Число):-СТРВЕЩ(Стр, Число).

% Первое решение цели: once(Цель) - ровно то, что делает ПЕРВОЕ/1
once(Цель):-ПЕРВОЕ(Цель).

% Цель решается или нет - всё равно успех: ignore(Цель)
ignore(Цель):-ВЫП(Цель), !.
ignore(_).

% Соседние целые: succ(Меньшее, Большее), Меньшее не меньше нуля. Второе
% предложение нужно, когда свободно Меньшее: тогда его находит Большее
succ(Меньшее, Большее):-ЦЕЛ(Меньшее), НЕ(БОЛЬШЕ(0, Меньшее)), !,
	Большее = #Меньшее + 1#.
succ(Меньшее, Большее):-ЦЕЛ(Большее), БОЛЬШЕ(Большее, 0),
	Меньшее = #Большее - 1#.

% Элемент по номеру с единицы, номер идёт первым: nth1(Номер, Список, Элемент).
% Форма с четырьмя аргументами - та же работа с накопителем, как у nth/4 в
% lists.pld: счётчик растёт на пути вперёд, поэтому известный номер не строит
% арифметику на возврате
nth1(Номер, Список, Элемент):-nth1(Список, 1, Номер, Элемент).
nth1([Элемент|_], Позиция, Позиция, Элемент).
nth1([_|Хвост], Позиция, Номер, Элемент):-Следующая = #Позиция + 1#,
	nth1(Хвост, Следующая, Номер, Элемент).

% Первое вхождение: memberchk(Элемент, Список) - одно решение, без перебора
memberchk(Элемент, Список):-member(Элемент, Список), !.
