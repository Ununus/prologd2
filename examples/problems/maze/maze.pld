% Лабиринт: мышь ищет сыр в обход стен - в ширину и в глубину, с показом шагов.
%
% Ввод (файл maze.input.txt, ключ -i):
%   N M          - высота и ширина лабиринта
%   X1 Y1        - мышь; X считается снизу, от 1, Y - слева, от 1
%   X2 Y2        - сыр
%   N строк по M символов: '#' - стена, '.' - проход
%
% Запуск:  prologu -I stdlib -i maze.input.txt -s maze.pld

:- ХОЛСТ(224, 224).

:- ИМПОРТ("lists.pld").
:- ИМПОРТ("maze.graphics.pld").

% ---- чтение ----
прочитать(N, M, МышьX, МышьY, СырX, СырY, Ряды):-ВВОДЦЕЛ(N), ВВОДЦЕЛ(M),
	ВВОДЦЕЛ(МышьX), ВВОДЦЕЛ(МышьY), ВВОДЦЕЛ(СырX), ВВОДЦЕЛ(СырY),
	прочитать_ряды(N, Ряды).
прочитать_ряды(0, []).
прочитать_ряды(N, [Строка | Остальные]):-БОЛЬШЕ(N, 0), ВВОДСТР(Строка),
	Меньше is N - 1, прочитать_ряды(Меньше, Остальные).

% Ряды хранятся как в файле - сверху вниз, а X считается снизу: клетка X - это
% ряд с номером (N - X), считая с нуля.
ряд([Строка | _], 0, Строка).
ряд([_ | Остальные], Номер, Строка):-БОЛЬШЕ(Номер, 0), Меньше is Номер - 1,
	ряд(Остальные, Меньше, Строка).

стена(Ряды, Высота, X, Y):-Номер is Высота - X, ряд(Ряды, Номер, Строка),
	КОПИЯ(Строка, Y, 1, "#").

свободно(Ряды, Высота, Ширина, X, Y):-БОЛЬШЕ(X, 0), БОЛЬШЕ(Y, 0), X =< Высота,
	Y =< Ширина, НЕ(стена(Ряды, Высота, X, Y)).

сосед(Ряды, Высота, Ширина, X, Y, X2, Y):-X2 is X + 1,
	свободно(Ряды, Высота, Ширина, X2, Y).
сосед(Ряды, Высота, Ширина, X, Y, X2, Y):-БОЛЬШЕ(X, 1), X2 is X - 1,
	свободно(Ряды, Высота, Ширина, X2, Y).
сосед(Ряды, Высота, Ширина, X, Y, X, Y2):-Y2 is Y + 1,
	свободно(Ряды, Высота, Ширина, X, Y2).
сосед(Ряды, Высота, Ширина, X, Y, X, Y2):-БОЛЬШЕ(Y, 1), Y2 is Y - 1,
	свободно(Ряды, Высота, Ширина, X, Y2).

% ---- в глубину: стек путей; клетка расширяется один раз ----
% Новые пути кладутся в НАЧАЛО: следующий берётся из глубины,
% путь в ширину - самый короткий,
% путь в глубину - просто первый найденный.
путь_в_глубину(Ряды, Высота, Ширина, ОтX, ОтY, ДоX, ДоY, Путь):-
	спуск(Ряды, Высота, Ширина, [[п(ОтX, ОтY)]], [], ДоX, ДоY, Путь).
спуск(_, _, _, [Текущий | _], _, ДоX, ДоY, Путь):-Текущий = [п(ДоX, ДоY) | _],
	!, reverse(Текущий, Путь).
спуск(Ряды, Высота, Ширина, [Текущий | Остальные], Посещённые, ДоX, ДоY, Путь):-
	Текущий = [п(X, Y) | _], ( member(п(X, Y), Посещённые) ->
		спуск(Ряды, Высота, Ширина, Остальные, Посещённые, ДоX, ДоY, Путь)
	; НАЙТИВСЕ(Следующий,
			(сосед(Ряды, Высота, Ширина, X, Y, СледX, СледY),
			 НЕ(member(п(СледX, СледY), Посещённые)),
			 Следующий = [п(СледX, СледY) | Текущий]),
			Новые),
		append(Новые, Остальные, Стек),
		спуск(Ряды, Высота, Ширина, Стек, [п(X, Y) | Посещённые], ДоX, ДоY, Путь)
	).

% ---- в ширину: очередь путей; клетка расширяется один раз ----
% Посещённые - клетки, которые уже стояли в голове очереди. Без этого одна и та
% же клетка приходит в очередь разными путями, и поиск растёт экспоненциально.
путь_в_ширину(Ряды, Высота, Ширина, ОтX, ОтY, ДоX, ДоY, Путь):-
	поиск(Ряды, Высота, Ширина, [[п(ОтX, ОтY)]], [], ДоX, ДоY, Путь).
поиск(_, _, _, [Текущий | _], _, ДоX, ДоY, Путь):-Текущий = [п(ДоX, ДоY) | _],
	!, reverse(Текущий, Путь).
поиск(Ряды, Высота, Ширина, [Текущий | Остальные], Посещённые, ДоX, ДоY, Путь):-
	Текущий = [п(X, Y) | _], ( member(п(X, Y), Посещённые) ->
		поиск(Ряды, Высота, Ширина, Остальные, Посещённые, ДоX, ДоY, Путь)
	; НАЙТИВСЕ(Следующий,
			(сосед(Ряды, Высота, Ширина, X, Y, СледX, СледY),
			 НЕ(member(п(СледX, СледY), Посещённые)),
			 Следующий = [п(СледX, СледY) | Текущий]),
			Новые),
		append(Остальные, Новые, Очередь),
		поиск(Ряды, Высота, Ширина, Очередь, [п(X, Y) | Посещённые], ДоX, ДоY, Путь)
	).

% ---- показ ----
нарисовать_лабиринт(Ряды, Высота, Ширина, СырX, СырY):-
	очистить_поле(Ширина, Высота), нарисовать_ряды(Ряды, Высота, Ширина, Высота),
	нарисовать_сыр(СырX, СырY, Высота).
нарисовать_ряды([], _, _, _).
нарисовать_ряды([Строка | Остальные], Высота, Ширина, X):-
	нарисовать_ряд(Строка, X, Ширина, 1, Высота), Меньше is X - 1,
	нарисовать_ряды(Остальные, Высота, Ширина, Меньше).
нарисовать_ряд(_, _, Ширина, Y, _):-БОЛЬШЕ(Y, Ширина), !.
нарисовать_ряд(Строка, X, Ширина, Y, Высота):-
	( КОПИЯ(Строка, Y, 1, "#") -> нарисовать_стенку(X, Y, Высота) ; ИСТИНА ),
	Следующая is Y + 1, нарисовать_ряд(Строка, X, Ширина, Следующая, Высота).

% Мышь идёт по пути: в новой клетке она рисуется, из покинутой стирается.
% Сыр возвращается на место, если мышь ушла с его клетки.
идти([], _, _, _).
идти([п(X, Y)], Высота, _, _):-нарисовать_мышь(X, Y, Высота).
идти([п(X, Y) | Остальные], Высота, СырX, СырY):-нарисовать_мышь(X, Y, Высота),
	ЖДИ(200), стереть_клетку(X, Y, Высота),
	( X = СырX, Y = СырY -> нарисовать_сыр(X, Y, Высота) ; ИСТИНА ),
	идти(Остальные, Высота, СырX, СырY).

% ---- два вопроса ----
в_ширину:-прочитать(N, M, X1, Y1, X2, Y2, Ряды),
	нарисовать_лабиринт(Ряды, N, M, X2, Y2),
	путь_в_ширину(Ряды, N, M, X1, Y1, X2, Y2, Путь), length(Путь, Длина),
	ВЫВОДПС(Длина), идти(Путь, N, X2, Y2).
в_глубину:-прочитать(N, M, X1, Y1, X2, Y2, Ряды),
	нарисовать_лабиринт(Ряды, N, M, X2, Y2),
	путь_в_глубину(Ряды, N, M, X1, Y1, X2, Y2, Путь), length(Путь, Длина),
	ВЫВОДПС(Длина), идти(Путь, N, X2, Y2).

% ---- запуск ----
% Куда глядим - туда идём
?ЧТЕНИЕ_ИЗ("maze.input.txt"), в_глубину.
% Кратчайший путь
%?ЧТЕНИЕ_ИЗ("maze.input.txt"), в_ширину.
