% Ханойская башня: пирамида из N дисков переезжает со стержня 1 на стержень 3.
%
% Классическая рекурсия (урок 4): перенести N-1 диск на вспомогательный стержень,
% перенести нижний диск, положить N-1 диск на него. Каждый перенос рисуется:
% frame/6 обводит диск чёрным, заливает его цветом и оставляет кадр через
% ЖДИ(100), а старое место стирается белым. Цвета берутся из stdlib/graphics.pld,
% по кругу из семи, от размера диска. Рисунок видно в окне (кнопка «Запустить»);
% в консоли графика молчит и остаётся только время пауз.
%
% Запуск:  prologu -s examples/problems/hanoi.pld
% В дереве исходников, где папки stdlib рядом с интерпретатором нет, - с ключом
% -I:  prologu -I stdlib -s examples/problems/hanoi.pld
:- ИМПОРТ("graphics.pld").

hanoi(N):-begin(N,A,B,C), move(N,1,3,2,A,B,C,_,_,_).
move(1,X,Y,_,A,B,C,D,E,F):-make(X,Y,A,B,C,D,E,F).
move(N,X,Y,Z,A,B,C,D,E,F):-БОЛЬШЕ(N,1), move(#N-1#,X,Z,Y,A,B,C,A_,B_,C_),
	make(X,Y,A_,B_,C_,D_,E_,F_), move(#N-1#,Z,Y,X,D_,E_,F_,D,E,F).
begin(N,A,[],[]):-БОЛЬШЕ(N,0), МЕНЬШЕ(N,15), list(N,B), rev(B,A), pyr(A).
list(1,[1]).
list(N,[N|M]):-БОЛЬШЕ(N,1), list(#N-1#,M).
rev([],[]).
rev([H|T_],L):-rev(T_,T), conc(T,[H],L).
conc([],L,L).
conc([H|A],B,[H|C]):-conc(A,B,C).
len([],0).
len([_|B_],L_):-len(B_,M), СЛОЖЕНИЕ(M,1,L_).
pyr([]).
pyr([N|T_]):-len(T_,H), disk(N,1,H), pyr(T_).
make(1,2,[A_|A],B,C,A,[A_|B],C):-len(A,D_), erase(A_,1,D_), len(B,E_),
	disk(A_,2,E_).
make(1,3,[A_|A],B,C,A,B,[A_|C]):-len(A,D_), erase(A_,1,D_), len(C,E_),
	disk(A_,3,E_).
make(2,3,A,[B_|B],C,A,B,[B_|C]):-len(B,D_), erase(B_,2,D_), len(C,E_),
	disk(B_,3,E_).
make(2,1,A,[B_|B],C,[B_|A],B,C):-len(B,D_), erase(B_,2,D_), len(A,E_),
	disk(B_,1,E_).
make(3,2,A,B,[C_|C],A,[C_|B],C):-len(C,D_), erase(C_,3,D_), len(B,E_),
	disk(C_,2,E_).
make(3,1,A,B,[C_|C],[C_|A],B,C):-len(C,D_), erase(C_,3,D_), len(A,E_),
	disk(C_,1,E_).

% disk(N,S,H) - диск размера N на стержне S на высоте H, erase - то же место
% белым: диск переехал, и старого места быть не должно.
disk(N,S,H):-colour(N,Цвет), чёрный(Линия),
	frame(#S*160-5*N#,#300-10*H-1#,#S*160+5*N#,#300-10*H-10#,Линия,Цвет), ЖДИ(100).
erase(N,S,H):-белый(Белый),
	frame(#S*160-5*N#,#300-10*H-1#,#S*160+5*N#,#300-10*H-10#,Белый,Белый).
frame(A_,B_,C_,D_,Линия,Заливка):-ЛИНИЯ(A_,B_,A_,D_,Линия),
	ЛИНИЯ(A_,D_,C_,D_,Линия), ЛИНИЯ(C_,D_,C_,B_,Линия), ЛИНИЯ(C_,B_,A_,B_,Линия),
	ЗАКРАСКА(#A_+1#,#B_-1#,Заливка).

% Цвет диска - по его размеру, по кругу из семи цветов библиотеки
colour(N,Цвет):-Остаток is (N - 1) mod 7 + 1, colour_of(Остаток,Цвет).
colour_of(1,Цвет):-красный(Цвет).
colour_of(2,Цвет):-оранжевый(Цвет).
colour_of(3,Цвет):-жёлтый(Цвет).
colour_of(4,Цвет):-зелёный(Цвет).
colour_of(5,Цвет):-голубой(Цвет).
colour_of(6,Цвет):-синий(Цвет).
colour_of(7,Цвет):-пурпурный(Цвет).

% Экран по умолчанию чёрный: сначала заливаем его белым, потом ставим башню.
?ЗАКРАСКА(1, 1, 16777215), hanoi(6).

% Башня побольше:
%?ЗАКРАСКА(1, 1, 16777215), hanoi(14).
