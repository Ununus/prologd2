% Факториал: Н! — это Н * (Н-1) * ... * 1, причём 0! = 1.
%
% Классическая рекурсия (урок 4): сначала считается факториал меньшего числа,
% потом результат умножается. Целые в Пролог-Д длинные, поэтому 100! считается
% точно, без потери разрядов.
%
% Запуск:  prologu -s examples/problems/factorial.pld

факториал(0, 1):-!.
факториал(Н, Ф):-факториал(#Н - 1#, Х), УМНОЖЕНИЕ(Х, Н, Ф).

?факториал(6, Ф).
%! Ф=720
?факториал(20, Ф).
%! Ф=2432902008176640000
