% Задача о рюкзаке: собрать самый дорогой набор, который умещается в предел.
%
% Вещи перебираются рекурсией (урок 4): очередную вещь либо берут, либо не берут.
% Готовые наборы собирает НАЙТИВСЕ (урок 10), а «лучший» - это набор, для которого
% нет более дорогого, который тоже помещается: вместо поиска максимума - двойное
% отрицание, как в уроке 4.
%
% Запуск:  prologu -s examples/problems/knapsack.pld

вещь(книга,   2, 3).
вещь(фонарь,  3, 4).
вещь(спички,  1, 1).
вещь(верёвка, 4, 6).
вещь(котелок, 5, 9).

предел(7).
все_вещи([книга, фонарь, спички, верёвка, котелок]).

% набор(Вещи, Взято, Вес, Цена): все подмножества списка Вещи.
набор([], [], 0, 0).
набор([Имя | Остальные], [Имя | Взято], Вес, Цена):-
	набор(Остальные, Взято, Вес_прочих, Цена_прочих), вещь(Имя, В, Ц),
	Вес = #В + Вес_прочих#, Цена = #Ц + Цена_прочих#.
набор([_ | Остальные], Взято, Вес, Цена):-набор(Остальные, Взято, Вес, Цена).

дороже(Вещи, Предел, Цена):-набор(Вещи, _Взято, Вес_другого, Цена_другого),
	НЕ(БОЛЬШЕ(Вес_другого, Предел)), БОЛЬШЕ(Цена_другого, Цена).

лучший(Взято, Вес, Цена):-предел(Предел), все_вещи(Вещи),
	набор(Вещи, Взято, Вес, Цена), НЕ(БОЛЬШЕ(Вес, Предел)),
	НЕ(дороже(Вещи, Предел, Цена)).

% Самый дорогой набор и его вес с ценой.
?лучший(Взято, Вес, Цена).
%! Взято=[книга,котелок]
%! Вес=7
%! Цена=12

% Все наборы ровно в предел веса - их собирает НАЙТИВСЕ.
?НАЙТИВСЕ(_Набор, (набор([книга, фонарь, спички, верёвка, котелок], _Набор, 7, _Цена)), Списки).
%! Списки=[[книга,спички,верёвка],[книга,котелок],[фонарь,верёвка]]
