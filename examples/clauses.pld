% База знаний как хранилище: товары и цены. Показаны предикаты библиотеки
% database.pld - clause_number, clauses, replace_clause, copy_predicate,
% rename_predicate и delete_predicate.
%
% Библиотека для работы над целым предикатом:
% номер, удаление, переименование, копия.
%
% Запуск:  prologd -I stdlib -s examples/clauses.pld

:- ИМПОРТ('database.pld').

товар(хлеб, 40).
товар(молоко, 80).
товар(сыр, 500).
товар(масло, 220).

дорогой(Товар):-товар(Товар, Цена), БОЛЬШЕ(Цена, 100).

% Номер предложения по голове: можно узнать, где лежит запись
?clause_number(товар(сыр, 500), Номер).
%! Номер=3

% У правила номер тоже есть, и голова у него общая
?clause_number(дорогой(сыр), НомерПравила).
%! НомерПравила=1

% Весь предикат читается списком: голова и цели тела
?clauses(дорогой, Правила).
%! Правила=[предложение(дорогой(_1),[товар(_1,_2),БОЛЬШЕ(_2,100)])]

% Новая цена встаёт на место старой: порядок товаров не меняется
?replace_clause(товар(молоко, 80), товар(молоко, 95)).
%! ДА
?НАЙТИВСЕ(Товар, товар(Товар, _), Порядок).
%! Товар=_1
%! Порядок=[хлеб,молоко,сыр,масло]

% Замена того, чего нет, базу не трогает: предикат ложен
?replace_clause(товар(сахар, 60), товар(сахар, 65)).
%! НЕТ

% Снимок: копия цен под другим именем, исходный предикат цел
?copy_predicate(товар, старый_товар).
%! ДА
?replace_clause(старый_товар(молоко, 95), старый_товар(молоко, 80)).
%! ДА
?товар(молоко, Сейчас), старый_товар(молоко, Было).
%! Сейчас=95
%! Было=80

% Переименование: копия под новым именем, старое имя снято
?rename_predicate(старый_товар, архив).
%! ДА
?СКОЛЬКО(старый_товар, Осталось).
%! Осталось=0
?архив(молоко, Было2).
%! Было2=80

% Снятие целой категории: все предложения имени, по всем арностям
категория(молочное).
категория(мучное).
?delete_predicate(категория).
%! ДА
?СКОЛЬКО(категория, Ноль).
%! Ноль=0
