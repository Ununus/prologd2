/* Родословная: предки, счёт родни и findall.
 *
 * Классический пример из книг: предикаты для поиска по базе знаний, findall
 * собирает все ответы в список, length их считает.
 *
 * Запуск:  prologu -I stdlib -s examples/iso/family.pld
 */
:- import("iso.pld").

родитель(аня, боря).
родитель(аня, вера).
родитель(боря, гриша).
родитель(вера, даша).
родитель(гриша, егор).

мужчина(боря).
мужчина(гриша).
мужчина(егор).

женщина(аня).
женщина(вера).
женщина(даша).

% Предок - родитель или предок родителя
предок(Кто, Кого):-родитель(Кто, Кого).
предок(Кто, Кого):-родитель(Кто, Между), предок(Между, Кого).

% Сестра или брат: общий родитель и другой пол
сестра_или_брат(Кто, Кому):-родитель(Общий, Кто), родитель(Общий, Кому),
	Кто \= Кому.

?предок(аня, Кто).
%! Кто=боря
%! Кто=вера
%! Кто=гриша
%! Кто=егор
%! Кто=даша

% findall собирает все ответы, length их считает
?findall(Кто, предок(аня, Кто), Потомки), length(Потомки, Сколько).
%! Кто=_1
%! Потомки=[боря,вера,гриша,егор,даша]
%! Сколько=5

% \= отбрасывает самого себя: «кто ещё ребёнок того же родителя»
?findall(Кто, сестра_или_брат(Кто, боря), Рядом), length(Рядом, Сколько).
%! Кто=_1
%! Рядом=[вера]
%! Сколько=1

?findall(Кто, мужчина(Кто), Мужчины).
%! Кто=_1
%! Мужчины=[боря,гриша,егор]
