/* `->` - если-то и если-то-иначе: выбор ветви без возврата.
 *
 * `(Условие -> Тогда)` берёт первое решение условия и выполняет следствие; нет
 * решений у условия - неудача. Пара `(Условие -> Тогда ; Иначе)` добавляет
 * ветвь «иначе»: здесь `;` значит «иначе», и если условие решилось, эта ветвь
 * отпадает даже тогда, когда следствие не решается. Знак слабее запятой и
 * сильнее `;`.
 *
 * Запуск:  prologd -s examples/iso/if_then.pld
 *
 * Подробности - в руководстве, раздел 4.5.
 */

цена(хлеб, 40).
цена(молоко, 20).

% Первое решение условия - и только оно: цена берётся у первого товара
?цена(Т, Ц) -> Ц < 50.
%! Т=хлеб
%! Ц=40

% Условие решилось (хлеб, 40), а следствие нет - и всё же неудача
?цена(Т, Ц) -> Ц < 30.
%! НЕТ

% Условие - вся пара, поэтому перебор идёт дальше, до молока
?(цена(Т, Ц), Ц < 30) -> 1 = 1.
%! Т=молоко
%! Ц=20

% Ветвь «иначе» для того же условия
?(цена(Т, Ц), Ц > 100) -> Т = дорого ; Т = иначе.
%! Т=иначе
%! Ц=_1

% А так «иначе» не берётся: условием была одна цена, и она решилась
?(цена(Т, Ц) -> Ц > 100 ; Т = иначе).
%! НЕТ

% Знаком `->` выбор пишется одним предложением
?(цена(Т, Ц), Ц < 30) -> Слово = дешёвое ; Слово = дорогое.
%! Т=молоко
%! Ц=20
%! Слово=дешёвое

% Правило: дешёвое - то, у чего цена меньше 30. Условие взято в скобки целиком,
% иначе запятая собрала бы `цена(Т, Ц), (Ц < 30 -> 1 = 1)`.
дешёвое(Т):-(цена(Т, Ц), Ц < 30 -> 1 = 1).

?дешёвое(Т).
%! Т=молоко

% Тот же знак работает и внутри findall
?findall(Т, (цена(Т, Ц), Ц < 30 -> 1 = 1), Список).
%! Т=_1
%! Ц=_1
%! Список=[молоко]
