% bagof/3 и setof/3.
%
% bagof - на каждую группу свободных переменных цели свой список;
% setof - то же, но список группы отсортирован и без повторов;
% D^Цель - "D не важно": переменная не дробит группы.
%
% Запуск:  prologd -s examples/iso/groups.pld

автор(gnu, диаса).
автор(gnu, драйвер).
автор(swi, вилемакер).
автор(swi, оки).

% Свободна D: два диалекта - две группы.
?bagof(A, автор(D, A), L).
%! A=_1
%! D=gnu
%! L=[диаса,драйвер]
%! A=_1
%! D=swi
%! L=[вилемакер,оки]

% D^ убирает диалект из ключа: группа одна, а порядок - как нашли.
?bagof(A, D^автор(D, A), L).
%! A=_1
%! D=_1
%! L=[диаса,драйвер,вилемакер,оки]

% setof сортирует группу и убирает повторы.
?setof(A, D^автор(D, A), L).
%! A=_1
%! D=_1
%! L=[вилемакер,диаса,драйвер,оки]

% Групп нет - bagof не имеет ответа (findall дал бы L=[]).
?bagof(A, ЛОЖЬ, L).
%! НЕТ
