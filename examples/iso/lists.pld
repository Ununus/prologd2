/* Библиотека ISO: member, append, length, last, nth1, msort, sort.
 *
 * Предикаты из stdlib/iso.pld со стандартной семантикой. sort/2 убирает
 * повторы, msort/2 оставляет их.
 *
 * Запуск:  prologd -I stdlib -s examples/iso/lists.pld
 */
:- import("iso.pld").

% Оставить только чётные числа: =:= сравнивает остаток с нулём
чётные([], []).
чётные([Первый|Остальные], [Первый|Итог]):-Остаток is Первый mod 2, Остаток =:= 0,
	!, чётные(Остальные, Итог).
чётные([_|Остальные], Итог):-чётные(Остальные, Итог).

?member(хлеб, [молоко, хлеб, сыр]).
%! ДА
?member(мясо, [молоко, хлеб, сыр]).
%! НЕТ
?append([1, 2], [3, 4], Итог).
%! Итог=[1,2,3,4]
?length([a, b, c], Длина).
%! Длина=3
?last([1, 2, 3], Последний).
%! Последний=3
?nth1(2, [a, b, c], Элемент).
%! Элемент=b

% msort оставляет повторы, sort их убирает
?msort([3, 1, 2, 1], С_Повторами).
%! С_Повторами=[1,1,2,3]
?sort([3, 1, 2, 1], Без_Повторов).
%! Без_Повторов=[1,2,3]

?чётные([1, 2, 3, 4, 5, 6], Только_Чётные).
%! Только_Чётные=[2,4,6]
?чётные([1, 3, 5], Только_Чётные).
%! Только_Чётные=[]
