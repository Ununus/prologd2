/* Порядок любых термов и две сортировки: compare/3, @<, sort/2, msort/2.
 *
 * Порядок ISO: сначала вид терма - переменная, число, текст, составной, - затем
 * внутри вида число по значению, текст по коду символа, составной по арности,
 * имени и аргументам. Список - составной терм '.', поэтому пары сортируются по
 * первому элементу.
 *
 * Запуск:  prologu -I stdlib -s examples/iso/order.pld
 */
:- import("iso.pld").

пролог("Д", "Григорьев").
пролог("GNU", "Диас").
пролог("SWI", "Вилемакер").
пролог("Visual", "PDC").

% Пример из книги: пары [Диалект, Автор] сортируются по первому элементу
?findall([Диалект, Автор], пролог(Диалект, Автор), Пары), sort(Пары, Порядок).
%! Диалект=_1
%! Автор=_1
%! Пары=[[Д,Григорьев],[GNU,Диас],[SWI,Вилемакер],[Visual,PDC]]
%! Порядок=[[GNU,Диас],[SWI,Вилемакер],[Visual,PDC],[Д,Григорьев]]

% compare/3 называет место двух термов: <, = или >
?compare(Место, 1, 2).
%! Место=<
?compare(Место, 2, 1).
%! Место=>
?compare(Место, 1, 1).
%! Место==

% Тот же вызов с готовым ответом - проверка
?compare(<, 1, 2).
%! ДА

% Знаки спрашивают то же самое короче
?1 @< 2.
%! ДА
?1 @>= 1.
%! ДА
?ф(1) @< ф(1, 2).
%! ДА
?[а, б] @< [б].
%! ДА
?молоко @< 1.
%! НЕТ

% Числа раньше текста, текст - раньше составных, арность раньше имени
?sort([1, молоко, [а], ф(б)], Сортировка).
%! Сортировка=[1,молоко,ф(б),[а]]

% sort/2 убирает повторы, msort/2 оставляет их
?msort([3, 1, 3], С_Повторами).
%! С_Повторами=[1,3,3]
?sort([3, 1, 3], Без_Повторов).
%! Без_Повторов=[1,3]
