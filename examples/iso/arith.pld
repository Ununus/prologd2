/* Арифметические знаки ISO: is, =:=, =\= и \=.
 *
 * Арифметика ISO-Пролога: X is Выраж, Выраж1 =:= Выраж2, Выраж1 =\= Выраж2.
 * Операнды — обычные арифметические выражения, без пометки #…#.
 * \= спрашивает про унификацию термов.
 *
 * Запуск:  prologu -I stdlib -s examples/iso/arith.pld
 */

:- import("iso.pld").

% Факториал: два арифметических знака в одном предложении
факториал(0, 1):-!.
факториал(Число, Результат):-Число > 0, Меньше is Число - 1,
	факториал(Меньше, Часть), Результат is Часть * Число.

% Сумма списка чисел
сумма([], 0).
сумма([Первый|Остальные], Всего):-сумма(Остальные, Часть), Всего is Часть + Первый.

% НОД: голые выражения по обе стороны от is
нод(A, 0, A):-!.
нод(A, B, Н):-Остаток is A mod B, нод(B, Остаток, Н).

% Среднее: =\= отсекает пустой список раньше, чем случится деление.
% Для целых «/» — деление нацело (10/4 = 2), поэтому вещественное среднее
% получают с вещественными числами.
среднее(Список, Среднее):-length(Список, Длина), Длина =\= 0, сумма(Список, Всего),
	Среднее is Всего / Длина.

?факториал(5, Ф).
%! Ф=120
?сумма([1, 2, 3, 4], С).
%! С=10
?нод(12, 18, Н).
%! Н=6
?среднее([1, 2, 3, 4], Ср).
%! Ср=2
?среднее([1.0, 2.0, 3.0], Ср).
%! Ср=2.0
?среднее([], Ср).
%! НЕТ

% =:= спрашивает про числа, и 1 и 1.0 — одно и то же число
?1 + 1 =:= 2.
%! ДА
?1 =:= 1.0.
%! ДА
?X = 2, X =:= 1 + 1.
%! X=2

% =\= — «арифметически не равно»
?3 =\= 1 + 1.
%! ДА

% \= спрашивает про унификацию: термы не унифицируются
?f(a) \= 1.
%! ДА
?f(a) \= f(b).
%! ДА
?f(a) \= f(a).
%! НЕТ
?2 \= 2.
%! НЕТ

% Свободная переменная унифицируется с чем угодно — значит «\=» ложно
?X \= 1.
%! НЕТ
?X = молоко, X \= хлеб.
%! X=молоко
