% Приёмы сортировки: шесть учебных реализаций.
%
% Предикаты этого файла:
% selectsort, insertsort, bubblesort, quicksort, mergesort, treesort,
% insert, change, split, halves, merge, make_tree, add_node, tree_list
%
% Это не стандартная библиотека, а пример: встроенная СОРТИРОВКА готова, работает
% быстрее и убирает повторы, а здесь видно, как сортировку делают выбором,
% вставкой, обменом, разделением, слиянием и деревом поиска. Все они сортируют по
% возрастанию, повторы оставляют на месте и сравнивают через встроенную БОЛЬШЕ -
% тем же порядком, что и СОРТИРОВКА, поэтому список строк сортируется так же.
%
% Запуск:  prologu -s examples/sorting.pld
% В дереве исходников, где папки stdlib рядом с интерпретатором нет, - с ключом
% -I:  prologu -I stdlib -s examples/sorting.pld
% Директива подключает lists.pld - сортировки на нём построены, - а вместе с ним
% iso.pld, откуда приходят append/3, а с ним merge/3 и tree_list/2.

:- ИМПОРТ("lists.pld").

% Сортировка выбором: selectsort(Список, Отсортирован) - взять минимум, затем
% отсортировать остаток
selectsort([], []).
selectsort(Список, [Минимум|ОтсортированныеОстальные]):-
	min_list(Список, Минимум), delete(Список, Минимум, БезМинимума),
	selectsort(БезМинимума, ОтсортированныеОстальные).

% Вставка элемента на своё место в отсортированный список:
% insert(Элемент, Отсортированный, Итог)
insert(Элемент, [], [Элемент]).
insert(Элемент, [Голова|Хвост], [Элемент, Голова|Хвост]):-
	НЕ(БОЛЬШЕ(Элемент, Голова)).
insert(Элемент, [Голова|Хвост], [Голова|Итог]):-БОЛЬШЕ(Элемент, Голова),
	insert(Элемент, Хвост, Итог).

% Сортировка вставкой: insertsort(Список, Отсортирован) - отсортировать хвост и
% вставить голову
insertsort([], []).
insertsort([Первый|Остальные], Отсортирован):-insertsort(Остальные, Часть),
	insert(Первый, Часть, Отсортирован).

% Обмен соседей: change(Список, ПослеОбмена) - первый обмен слева направо
change([Первый, Второй|Хвост], [Второй, Первый|Хвост]):-БОЛЬШЕ(Первый, Второй).
change([Голова|Хвост], [Голова|Изменённый]):-change(Хвост, Изменённый).

% Пузырьковая сортировка: bubblesort(Список, Отсортирован) - обменивать, пока
% есть что менять
bubblesort(Список, Отсортирован):-change(Список, Изменённый), !,
	bubblesort(Изменённый, Отсортирован).
bubblesort(Отсортирован, Отсортирован).

% Разделение относительно опоры: split(Опора, Список, Меньшие, Большие)
split(_, [], [], []).
split(Опора, [Голова|Хвост], [Голова|Меньшие], Большие):-
	НЕ(БОЛЬШЕ(Голова, Опора)), split(Опора, Хвост, Меньшие, Большие).
split(Опора, [Голова|Хвост], Меньшие, [Голова|Большие]):-БОЛЬШЕ(Голова, Опора),
	split(Опора, Хвост, Меньшие, Большие).

% Быстрая сортировка: quicksort(Список, Отсортирован) - разделить, отсортировать
% части, склеить
quicksort([], []).
quicksort([Опора|Хвост], Отсортирован):-split(Опора, Хвост, Меньшие, Большие),
	quicksort(Меньшие, ОтсортированныеМеньшие),
	quicksort(Большие, ОтсортированныеБольшие),
	append(ОтсортированныеМеньшие, [Опора|ОтсортированныеБольшие], Отсортирован).

% Деление списка пополам: halves(Список, Первая, Вторая)
halves([], [], []).
halves([Элемент], [Элемент], []).
halves([Первый, Второй|Хвост], [Первый|Первая], [Второй|Вторая]):-
	halves(Хвост, Первая, Вторая).

% Слияние двух отсортированных списков: merge(Первый, Второй, Итог). Из двух
% голов берётся та, что не больше, - тогда слияние устойчиво
merge([], Второй, Второй):-!.
merge(Первый, [], Первый):-!.
merge([ГоловаПервого|ХвостПервого], [ГоловаВторого|ХвостВторого], [ГоловаПервого|Итог]):-
	НЕ(БОЛЬШЕ(ГоловаПервого, ГоловаВторого)),
	merge(ХвостПервого, [ГоловаВторого|ХвостВторого], Итог).
merge([ГоловаПервого|ХвостПервого], [ГоловаВторого|ХвостВторого], [ГоловаВторого|Итог]):-
	БОЛЬШЕ(ГоловаПервого, ГоловаВторого),
	merge([ГоловаПервого|ХвостПервого], ХвостВторого, Итог).

% Сортировка слиянием: mergesort(Список, Отсортирован) - разделить пополам,
% отсортировать части, слить
mergesort([], []):-!.
mergesort([Элемент], [Элемент]):-!.
mergesort(Список, Отсортирован):-halves(Список, Первая, Вторая),
	mergesort(Первая, ОтсортированнаяПервая),
	mergesort(Вторая, ОтсортированнаяВторая),
	merge(ОтсортированнаяПервая, ОтсортированнаяВторая, Отсортирован).

% Дерево поиска из списка: make_tree(Список, Дерево); make_tree/3 - та же работа
% с накопителем
make_tree(Список, Дерево):-make_tree(Список, Дерево, empty).
make_tree([], Дерево, Дерево).
make_tree([Элемент|Хвост], Дерево, Начальное):-
	add_node(Элемент, Начальное, Следующее), make_tree(Хвост, Дерево, Следующее).

% Добавление элемента в дерево поиска: add_node(Элемент, Дерево, НовоеДерево).
% Меньший уходит влево, остальные вправо, поэтому дерево упорядочено.
add_node(Элемент, empty, node(Элемент, empty, empty)).
add_node(Элемент, node(Корень, Левое, Правое), node(Корень, НовоеЛевое, Правое)):-
	МЕНЬШЕ(Элемент, Корень), add_node(Элемент, Левое, НовоеЛевое).
add_node(Элемент, node(Корень, Левое, Правое), node(Корень, Левое, НовоеПравое)):-
	НЕ(МЕНЬШЕ(Элемент, Корень)), add_node(Элемент, Правое, НовоеПравое).

% Обход дерева по возрастанию: tree_list(Дерево, Список)
tree_list(empty, []).
tree_list(node(Корень, Левое, Правое), Список):-tree_list(Левое, Левый),
	tree_list(Правое, Правый), append(Левый, [Корень|Правый], Список).

% Сортировка деревом: treesort(Список, Отсортирован) - построить дерево и обойти
treesort(Список, Отсортирован):-make_tree(Список, Дерево),
	tree_list(Дерево, Отсортирован).

% Что получится: все шесть дают один и тот же ответ, повторы на месте
?selectsort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?insertsort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?bubblesort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?quicksort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?mergesort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?treesort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]

% Дерево поиска видно целиком
?make_tree([3, 1, 2], Дерево).
%! Дерево=node(3,node(1,empty,node(2,empty,empty)),empty)

% Порядок тот же, что у встроенной БОЛЬШЕ, поэтому строки тоже сортируются
?quicksort([груша, яблоко, айва], Отсортирован).
%! Отсортирован=[айва,груша,яблоко]
