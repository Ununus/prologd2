% Стандартная библиотека: что в ней есть. Запуск:
%   prologu -I stdlib -s examples/stdlib_demo.pld
% Ключ -I нужен потому, что в дереве исходников папки stdlib рядом с интерпретатором
% нет, а в пакете интерпретатор находит её сам, и там запуск —
%   prologu -i examples/stdlib_demo.input.txt -s examples/stdlib_demo.pld
% В окне папку stdlib (если она не рядом с интерпретатором) добавляют один раз:
% «Правка → Настройки… → Выполнение → Дополнительные каталоги ИМПОРТ»; то, что
% читают read_words и read_numbers, там вводят на вкладке «Ввод» (в командной
% строке — ключом -i, файл examples/stdlib_demo.input.txt).
%
% Строки с %! — то, что печатает интерпретатор; за этим следит тест, поэтому
% пример не может разойтись с библиотекой.

:- ИМПОРТ("lists.pld").
:- ИМПОРТ("sets.pld").
:- ИМПОРТ("sorts.pld").
:- ИМПОРТ("strings.pld").
:- ИМПОРТ("math.pld").

% Списки: длина, поиск, края, соседи, минимум, максимум и сумма
?length([молоко, хлеб, сыр], Длина).
%! Длина=3
?member(Что, [молоко, хлеб]).
%! Что=молоко
%! Что=хлеб
?head([молоко, хлеб], Первый).
%! Первый=молоко
?tail([молоко, хлеб, сыр], Хвост).
%! Хвост=[хлеб,сыр]
?last([молоко, хлеб], Последний).
%! Последний=хлеб
?adjacent([молоко, хлеб, сыр], Сосед, Следующий).
%! Сосед=молоко
%! Следующий=хлеб
%! Сосед=хлеб
%! Следующий=сыр
?min_list([3, 1, 2], Минимум).
%! Минимум=1
?max_list([3, 1, 2], Максимум).
%! Максимум=3
?sum_list([1, 2, 3], Сумма).
%! Сумма=6

% Списки: элемент по номеру и края по числу
?nth([молоко, хлеб, сыр], 2, Второй).
%! Второй=хлеб
?nth([молоко, хлеб, сыр], Номер, Элемент).
%! Номер=1
%! Элемент=молоко
%! Номер=2
%! Элемент=хлеб
%! Номер=3
%! Элемент=сыр
?head_n([молоко, хлеб, сыр], 2, Начало).
%! Начало=[молоко,хлеб]
?last_n([молоко, хлеб, сыр], 2, Конец).
%! Конец=[хлеб,сыр]

% Списки: построение и разбор
?append([молоко, хлеб], [сыр], Целый).
%! Целый=[молоко,хлеб,сыр]
?reverse([1, 2, 3], Обратный).
%! Обратный=[3,2,1]
?flatten([[1, [2, 3]], 4], Плоский).
%! Плоский=[1,2,3,4]
?delete([a, b, a], a, ПослеУдаления).
%! ПослеУдаления=[b,a]
?delete_all([a, b, a], a, БезВхождений).
%! БезВхождений=[b]
?substitute([a, b, a], a, c, Замена).
%! Замена=[c,b,c]
?select([a, b], Выбранный, Остаток).
%! Выбранный=a
%! Остаток=[b]
%! Выбранный=b
%! Остаток=[a]
?permutation([a, b], Перестановка).
%! Перестановка=[a,b]
%! Перестановка=[b,a]
?prefix([a, b], [a, b, c]).
%! ДА
?suffix([b, c], [a, b, c]).
%! ДА
?sublist([b, c], [a, b, c]).
%! ДА
?НАЙТИВСЕ(Элемент, member(Элемент, [1, 2, 2, 3]), ВсеЭлементы).
%! Элемент=_1
%! ВсеЭлементы=[1,2,2,3]

% Работа целью: map, filter и fold
двойное(Число, Двойное):-Двойное = #Число * 2#.
?map(двойное, [1, 2, 3], Удвоенные).
%! Удвоенные=[2,4,6]
?filter(ЦЕЛ, [1, молоко, 2], ТолькоЧисла).
%! ТолькоЧисла=[1,2]
?fold(СЛОЖЕНИЕ, [1, 2, 3], 0, СуммаЦелых).
%! СуммаЦелых=6

% Множества
?set([3, 1, 3, 2], Множество).
%! Множество=[1,2,3]
?unique([3, 1, 3, 2], БезПовторов).
%! БезПовторов=[3,1,2]
?subset([1, 2], [3, 2, 1]).
%! ДА
?equalset([1, 2], [2, 1, 1]).
%! ДА
?unionset([1, 2], [2, 3], Объединение).
%! Объединение=[1,2,3]
?intersect([1, 2, 3], [2, 3, 4], Пересечение).
%! Пересечение=[2,3]
?difset([1, 2, 3], [3, 4], Разность).
%! Разность=[1,2]

% Сортировки: msort оставляет повторы, СОРТИРОВКА их убирает, остальные шесть
% делают то же, что msort
?msort([3, 1, 2, 1], СПовторами).
%! СПовторами=[1,1,2,3]
?СОРТИРОВКА([3, 1, 2, 1], БезПовторов).
%! БезПовторов=[1,2,3]
?selectsort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?insertsort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?bubblesort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?quicksort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?mergesort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?treesort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]

% Дерево поиска видно целиком
?make_tree([3, 1, 2], Дерево).
%! Дерево=node(3,node(1,empty,node(2,empty,empty)),empty)

% Порядок тот же, что у встроенной БОЛЬШЕ, поэтому строки тоже сортируются
?quicksort([груша, яблоко, айва], Отсортирован).
%! Отсортирован=[айва,груша,яблоко]
?СОРТИРОВКА([груша, яблоко, айва], ДляСравнения).
%! ДляСравнения=[айва,груша,яблоко]

% Строки: пробелы, слова, замена и разбор чисел
?trim("  молоко  ", Обрезанная).
%! Обрезанная=молоко
?words("молоко   и   хлеб", Слова).
%! Слова=[молоко,и,хлеб]
?join([молоко, и, хлеб], Строка).
%! Строка=молоко и хлеб
?join(["1", "2"], "-", ЧерезДефис).
%! ЧерезДефис=1-2
?replace("молоко и молоко", "молоко", "сыр", Замена).
%! Замена=сыр и сыр
?to_numbers(["4", "хлеб", "2.5"], ЧислаИзСтрок).
%! ЧислаИзСтрок=[4,2.5]

% Целые числа
?between(1, 3, Число).
%! Число=1
%! Число=2
%! Число=3
?gcd(12, 18, НОД).
%! НОД=6
?lcm(4, 6, НОК).
%! НОК=12
?power(2, 10, Степень).
%! Степень=1024
?factorial(20, Факториал).
%! Факториал=2432902008176640000
?is_prime(97).
%! ДА
?is_prime(91).
%! НЕТ
?primes(20, Простые).
%! Простые=[2,3,5,7,11,13,17,19]

% Печать и чтение
?print_list([молоко, хлеб]).
%! молоко хлеб
%! ДА
?read_words(Слова), to_numbers(Слова, ЧислаИзВвода).
%! Слова=[молоко,4,хлеб]
%! ЧислаИзВвода=[4]
?read_numbers(3, Числа).
%! Числа=[4,8,15]
