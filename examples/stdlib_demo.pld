% Стандартная библиотека: что в ней есть.  Запуск:
%   prologd -I stdlib -s examples/stdlib_demo.pld
% В окне папку stdlib добавляют один раз: «Правка → Настройки… → Выполнение →
% Дополнительные каталоги ИМПОРТ»; числа для read_numbers там вводят на вкладке
% «Ввод» (в командной строке — ключом -i, файл examples/stdlib_demo.input.txt).
%
% Строки с %! — то, что печатает интерпретатор; за этим следит тест, поэтому
% пример не может разойтись с библиотекой.

:- ИМПОРТ("lists.pld").
:- ИМПОРТ("sets.pld").
:- ИМПОРТ("sorts.pld").

% Списки: длина, поиск, края, соседи, минимум и максимум
?length([молоко, хлеб, сыр], Длина).
%! Длина=3
?member(Что, [молоко, хлеб]).
%! Что=молоко
%! Что=хлеб
?head([молоко, хлеб], Первый).
%! Первый=молоко
?last([молоко, хлеб], Последний).
%! Последний=хлеб
?adjacent([молоко, хлеб, сыр], Сосед, Следующий).
%! Сосед=молоко
%! Следующий=хлеб
%! Сосед=хлеб
%! Следующий=сыр
?min_list([3, 1, 2], Минимум).
%! Минимум=1
?max_list([3, 1, 2], Максимум).
%! Максимум=3

% Списки: построение и разбор
?append([молоко, хлеб], [сыр], Целый).
%! Целый=[молоко,хлеб,сыр]
?reverse([1, 2, 3], Обратный).
%! Обратный=[3,2,1]
?flatten([[1, [2, 3]], 4], Плоский).
%! Плоский=[1,2,3,4]
?delete([a, b, a], a, ПослеУдаления).
%! ПослеУдаления=[b,a]
?delete_all([a, b, a], a, БезВхождений).
%! БезВхождений=[b]
?substitute([a, b, a], a, c, Замена).
%! Замена=[c,b,c]
?select([a, b], Выбранный, Остаток).
%! Выбранный=a
%! Остаток=[b]
%! Выбранный=b
%! Остаток=[a]
?permutation([a, b], Перестановка).
%! Перестановка=[a,b]
%! Перестановка=[b,a]
?prefix([a, b], [a, b, c]).
%! ДА
?suffix([b, c], [a, b, c]).
%! ДА
?sublist([b, c], [a, b, c]).
%! ДА
?НАЙТИВСЕ(Элемент, member(Элемент, [1, 2, 2, 3]), ВсеЭлементы).
%! Элемент=_1
%! ВсеЭлементы=[1,2,2,3]

% Множества
?set([3, 1, 3, 2], Множество).
%! Множество=[1,2,3]
?unique([3, 1, 3, 2], БезПовторов).
%! БезПовторов=[3,1,2]
?subset([1, 2], [3, 2, 1]).
%! ДА
?equalset([1, 2], [2, 1, 1]).
%! ДА
?unionset([1, 2], [2, 3], Объединение).
%! Объединение=[1,2,3]
?intersect([1, 2, 3], [2, 3, 4], Пересечение).
%! Пересечение=[2,3]
?difset([1, 2, 3], [3, 4], Разность).
%! Разность=[1,2]

% Сортировки: все шесть дают одно и то же, а повторы оставляют на месте
?selectsort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?insertsort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?bubblesort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?quicksort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?mergesort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]
?treesort([3, 1, 2, 1], Отсортирован).
%! Отсортирован=[1,1,2,3]

% Дерево поиска видно целиком
?make_tree([3, 1, 2], Дерево).
%! Дерево=node(3,node(1,empty,node(2,empty,empty)),empty)

% Порядок тот же, что у встроенной БОЛЬШЕ, поэтому строки тоже сортируются
?quicksort([груша, яблоко, айва], Отсортирован).
%! Отсортирован=[айва,груша,яблоко]
?СОРТИРОВКА([груша, яблоко, айва], ДляСравнения).
%! ДляСравнения=[айва,груша,яблоко]

% Печать и чтение
?print_list([молоко, хлеб]).
%! молоко хлеб
%! ДА
?read_numbers(3, Числа).
%! Числа=[4,8,15]
