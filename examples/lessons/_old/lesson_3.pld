:- ИМЕНА(1).
%Файл написан в старом диалекте: строчная буква — переменная, имя с большой буквы
%без кавычек — строковая константа. Так читались имена в старом курсе, и первая
%строка файла задаёт этот режим (он же `--vars 1`).
сколько(С,Б,0):-НЕ(КОПИЯ(С,Х,У,Б)), !.
%сколько(с,б,1):-КОПИЯ(с,1,у,б).
% н=1 н=2 н=3
%сколько(с,б,1):-КОПИЯ(с,1,у,б),!.
% н=1
% КОПИЯ с двумя свободными аргументами находит ПЕРВОЕ вхождение с начала
% строки, поэтому счёт идёт по остатку после него, а единица - это случай,
% когда вхождение занимает всю строку целиком.
сколько(С,Б,1):-КОПИЯ(С,Х,У,Б), РАВНО(Х,1), ДЛИНА(С,Д), РАВНО(Д,У), !.
сколько(С,Б,Н):-КОПИЯ(С,Х,У,Б), ДЛИНА(С,Д), КОПИЯ(С,#Х+У#,#Д-Х-У+1#,Т),
	сколько(Т,Б,М), СЛОЖЕНИЕ(М,1,Н).
?сколько(идиотизм,"и",н).
%! н=3

обращение(С,С):-ДЛИНА(С,1), !.
обращение(С,Т):-ДЛИНА(С,Д), КОПИЯ(С,1,1,А), КОПИЯ(С,2,#Д-1#,Б), обращение(Б,В),
	СЦЕП(В,А,Т).
?обращение(абвгдежз,с).
%! с=зжедгвба

% Замена всех вхождений: вырезается первое из них, части склеиваются
% заново, и так до тех пор, пока вхождений не останется.
замена(А,Б,С,Т):-КОПИЯ(С,Х,У,А), !, КОПИЯ(С,1,#Х-1#,П), ДЛИНА(С,Д),
	КОПИЯ(С,#Х+У#,#Д-Х-У+1#,Р), СЦЕП(П,Б,Ф), СЦЕП(Ф,Р,Ю), замена(А,Б,Ю,Т).
замена(А,Б,С,С).
?замена("а","ю",абвабва,т).
%! т=юбвюбвю

% Удаление всех вхождений: первое из них вырезается, и так до конца строки.
удаление(А,С,Т):-КОПИЯ(С,Х,У,А), !, КОПИЯ(С,1,#Х-1#,П), ДЛИНА(С,Д),
	КОПИЯ(С,#Х+У#,#Д-Х-У+1#,Р), СЦЕП(П,Р,Ю), удаление(А,Ю,Т).
удаление(А,С,С).
?удаление("а",абракадабра,ю).
%! ю=бркдбр

скобки(С):-сколько(С,"(",Н), сколько(С,")",Н), !, проверка1(С), проверка2(С).
скобки(С):-ВЫВОД("Неравное количество левых и правых скобок в строке ",С).
проверка1(С):-КОПИЯ(С,Х,1,"("), КОПИЯ(С,У,1,")"), МЕНЬШЕ(Х,У), !.
проверка1(С):-
	ВЫВОД("Неверный порядок скобок в строке: последняя скобка - левая",С).
%проверка2(с):-обращение(с,т),НЕ(проверка1(т)),!.
проверка2(С):-левый(С,Х,1,"("), левый(С,У,1,")"), МЕНЬШЕ(Х,У), !.
проверка2(С):-
	ВЫВОД("Неверный порядок скобок в строке: первая скобка - правая ",С).
?скобки("()(()()()))(").
%! Неверный порядок скобок в строке: первая скобка - правая ()(()()()))(
%! ДА
левый(С,А,Н):-КОПИЯ(С,Н,1,А), КОПИЯ(С,1,#Н-1#,Т), НЕ(КОПИЯ(Т,Х,1,А)), !.
левый(С,А,Н):-КОПИЯ(С,К,1,А), КОПИЯ(С,1,#К-1#,Т), левый(Т,Н,1,А).
