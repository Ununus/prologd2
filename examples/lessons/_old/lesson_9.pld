% доступ к структуре программы

%СКОЛЬКО(Арг1,Арг2)
%УДАЛЕНИЕ(Арг1,Арг2)
%ТЕРМ(Арг1,Арг2)
%ПРЕДЛ(Арг1,Арг2,Арг3,Арг4)
%ДОБ(Арг1,Арг2,Арг3)

%?ПРЕДЛ(Фиб,1,б,в).
%Фиб(н,ф):-БОЛЬШЕ(н,2),!,Фиб(#н-2#,а),Фиб(#н-1#,б),СЛОЖЕНИЕ(а,б,ф),ВЫВОД(н," ",ф).

фиб(1,1).
фиб(2,1).

%?Фиб(10,ф).

% создание новых фактов в ходе диалога
оценка([]).
хороший('Капица').
оценка([Г|Х]):-СЦЕП(Г," - хороший? (да или нет)",В),ВВОДСИМВ(О,В),анализ(О,Г),оценка(Х).
анализ(да,Г):-!,ТЕРМ(Т,[хороший,Г]),ДОБ(Т,[],1).
анализ(нет,Г):-!,ТЕРМ(Т,[плохой,Г]),ДОБ(Т,[],999).
анализ(_,Г):-оценка([Г]).
?оценка(['Чехов','Ленин','Сталин','Пушкин','Менделеев','Лысенко','Королев']).
?СКОЛЬКО(хороший,Э).
?хороший(Х).
?СКОЛЬКО(плохой,Я).
?плохой(П).



