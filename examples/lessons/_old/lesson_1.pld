:- ИМЕНА(1).
%Файл написан в старом диалекте: строчная буква — переменная, имя с большой буквы
%без кавычек — строковая константа. Так читались имена в старом курсе, и первая
%строка файла задаёт этот режим (он же `--vars 1`).
% факты
русан(небо,sky).
русан(солнце,sun).
русан(звезда,star).

% запросы и переменные
?русан(небо,sky).
%! ДА
?русан(небо,star).
%! НЕТ
?русан(небо,x).
%! x=sky
?русан(x,sky).
%! x=небо
?русан(x,y).
%! x=небо
%! y=sky
%! x=солнце
%! y=sun
%! x=звезда
%! y=star
?русан(небо,_).
%! ДА
?русан(_,X).
%! X=sky
%! X=sun
%! X=star

руснем(небо,Himmel).
руснем(солнце,Sonne).
руснем(звезда,Stelle).

% сложный запрос
?русан(X,sky), руснем(X,Y).
%! X=небо
%! Y=Himmel

% правила
неман(Н,А):-руснем(Р,Н), русан(Р,А).
?неман(Stelle,A).
%! A=star

% альтернативы
мама(Лена,Таня).
мама(Таня,Зина).
мама(Надя,Саша).
папа(Саша,Зина).
бабушка(Б,В_):-мама(Б,М_), мама(М_,В_).
бабушка(Б,В_):-мама(Б,П_), папа(П_,В_).
?бабушка(Б,Зина).
%! Б=Лена
%! Б=Надя

папа(Александр,Гриша).
папа(Сергей,Александр).
папа(Николай,Наталья).
мама(Наталья,Гриша).
дед(Д,В):-папа(Д,П), папа(П,В).
дед(Д,В):-папа(Д,М), мама(М,В).
?дед(Д,Гриша).
%! Д=Сергей
%! Д=Николай

возр(Галя,60).возр(Боря,65).возр(Оля,19).возр(Света,45).возр(Саша,46).
% определяем человека, для которого существуют более старшие
есть_старше(А):-возр(А,Б), возр(В_,Г), БОЛЬШЕ(Г,Б).
% самый старший - это тот, для которого нет более старших
старший(А,Б):-возр(А,Б), НЕ(есть_старше(А)).
?старший(И,В_).
%! И=Боря
%! В_=65
%и=Боря
%в=65

% арифметика
?СЛОЖЕНИЕ(5,7,12).
%! ДА
?СЛОЖЕНИЕ(5,7,х).
%! х=12
?СЛОЖЕНИЕ(5,Х,12).
%! Х=7
вычитание(И,Й,К):-СЛОЖЕНИЕ(Й,К,И).
?УМНОЖЕНИЕ(5,7,35).
%! ДА
?УМНОЖЕНИЕ(Х,7,35).
%! Х=5

% деление нацело с остатком a*b+c=d
?УМНОЖЕНИЕ(9,3,2,29).
%! ДА
?УМНОЖЕНИЕ(9,х,у,29).
%! х=3
%! у=2

% явные вычисления
?РАВНО(а,5), РАВНО(в,#а*2+3#).
%! а=5
%! в=13

% рекурсия
факториал(0,1).
факториал(Н,Ф):-БОЛЬШЕ(Н,0), факториал(#Н-1#,Х), УМНОЖЕНИЕ(Х,Н,Ф).
?факториал(7,ф).
%! ф=5040

% отсечение как исключающее ИЛИ
фактор(0,1):-!.
фактор(Н,Ф):-фактор(#Н-1#,Х), УМНОЖЕНИЕ(Х,Н,Ф).
?фактор(7,Ф).
%! Ф=5040

% наименьший общий делитель
нод(А,А,А).
нод(А,Б,Н):-БОЛЬШЕ(А,Б), !, нод(#А-Б#,Б,Н).
нод(А,Б,Н):-нод(#Б-А#,Б,Н).
%Этот запрос не завершается за минуту, поэтому оставлен закомментированным.
%?нод(30,125,н).

% числа Фибоначчи
фиб(0,1).
фиб(1,1).
фиб(Н,Ф):-БОЛЬШЕ(Н,1), фиб(#Н-2#,Х), фиб(#Н-1#,Г), СЛОЖЕНИЕ(Х,Г,Ф).
?фиб(10,ф).
%! ф=89

% оптимизация рекурсии
фи(1,1,1):-!.
фи(Н,Г,Ф):-фи(#Н-1#,Х,Г), СЛОЖЕНИЕ(Х,Г,Ф).
?фи(10,_,ф).
%! ф=89
