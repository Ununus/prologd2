% ============================================================================
% Урок 8. Поиск по пространству состояний
%
% Цель: решать задачи перебором: описать состояние, ход и цель, а поиск пусть
%       делает интерпретатор.
% Новое: пространство состояний, поиск в глубину, память о посещённом,
%        порождение и проверка.
% Справка: doc/help.typ, разделы 2 и 4 (отсечение и отрицание).
%
% ============================================================================

% ----------------------------------------------------------------------------
% 1. Переливания: состояние, ход, цель
% ----------------------------------------------------------------------------
% Задачу удобно решать, если описать три вещи:
%   * состояние - то, что полностью описывает положение дел;
%   * ход - переход из одного состояния в другое;
%   * цель - проверка "мы уже там?".
% Дальше интерпретатор сам перебирает ходы, пока не дойдёт до цели.
% Здесь состояние - пара с(ВПервом, ВоВтором): сколько литров в пятилитровом и
% трёхлитровом сосуде. Ходов шесть: наполнить, вылить и перелить в любую сторону.

ход(с(ВПервом, ВоВтором), налить(первый), с(5, ВоВтором)):-МЕНЬШЕ(ВПервом, 5).
ход(с(ВПервом, ВоВтором), налить(второй), с(ВПервом, 3)):-МЕНЬШЕ(ВоВтором, 3).
ход(с(ВПервом, ВоВтором), вылить(первый), с(0, ВоВтором)):-БОЛЬШЕ(ВПервом, 0).
ход(с(ВПервом, ВоВтором), вылить(второй), с(ВПервом, 0)):-БОЛЬШЕ(ВоВтором, 0).
% Переливание: сколько поместится, столько и переходит. Два предложения - это
% два случая: всё уместилось (первый сосуд пуст) или второй наполнился до края.
ход(с(ВПервом, ВоВтором), перелить(первый, второй), с(0, Всего)):-БОЛЬШЕ(ВПервом,
	0), МЕНЬШЕ(ВоВтором, 3), СЛОЖЕНИЕ(ВПервом, ВоВтором, Всего), НЕ(БОЛЬШЕ(Всего,
	3)).
ход(с(ВПервом, ВоВтором), перелить(первый, второй), с(Остаток, 3)):-БОЛЬШЕ(
	ВПервом, 0), МЕНЬШЕ(ВоВтором, 3), СЛОЖЕНИЕ(ВПервом, ВоВтором, Всего),
	БОЛЬШЕ(Всего, 3), СЛОЖЕНИЕ(Остаток, 3, Всего).
ход(с(ВПервом, ВоВтором), перелить(второй, первый), с(Всего, 0)):-БОЛЬШЕ(ВоВтором,
	0), МЕНЬШЕ(ВПервом, 5), СЛОЖЕНИЕ(ВПервом, ВоВтором, Всего), НЕ(БОЛЬШЕ(Всего,
	5)).
ход(с(ВПервом, ВоВтором), перелить(второй, первый), с(5, Остаток)):-БОЛЬШЕ(
	ВоВтором, 0), МЕНЬШЕ(ВПервом, 5), СЛОЖЕНИЕ(ВПервом, ВоВтором, Всего),
	БОЛЬШЕ(Всего, 5), СЛОЖЕНИЕ(5, Остаток, Всего).

% Цель этой задачи: ровно 4 литра в первом сосуде. У цели много решений, но
% поиску достаточно первого - поэтому отсечение.
достигнута(с(4, _)).

% Член/2 уже был в уроке 5: он ищет элемент в списке и умеет их перебирать.
член(Элемент, [Элемент | _]).
член(Элемент, [_ | Хвост]):-член(Элемент, Хвост).

% А теперь сам поиск - он занимает четыре строки, и это весь перебор.
% История - список состояний, где мы уже были. Без неё поиск ходил бы кругами:
% из состояния можно вернуться в предыдущее, и конца этому нет.
% История копится накопителем (урок 4) и нужна только для проверки; а список
% ходов собирается сразу в прямом порядке - каждый сделанный ход встаёт в
% голову результата.
идти(Состояние, _, []):-достигнута(Состояние), !.
идти(Состояние, История, [Ход | Ходы]):-ход(Состояние, Ход, След),
	НЕ(член(След, История)), идти(След, [След | История], Ходы).

% Входной предикат задачи отсечением оставляет только первый найденный путь:
% иначе интерпретатор после ответа пошёл бы искать следующие, и на экране
% появилась бы трасса каждого из них.
переливы(Путь):-идти(с(0, 0), [с(0, 0)], Путь), !.

% Печать решения: шаги/2 идёт по найденным ходам заново и показывает состояние
% после каждого - это и проверка, что путь действительно ведёт к цели.
шаги(Состояние, []):-ВЫВОД("готово: ", Состояние), ПС.
шаги(Состояние, [Ход | Ходы]):-ход(Состояние, Ход, След),
	ВЫВОД(Состояние, " --", Ход, "--> ", След), ПС, шаги(След, Ходы).

% ТИХО убирает ответ интерпретатора: печатает сама программа (урок 7).
?ТИХО, переливы(Ходы), шаги(с(0, 0), Ходы).
%! с(0,0) --налить(первый)--> с(5,0)
%! с(5,0) --налить(второй)--> с(5,3)
%! с(5,3) --вылить(первый)--> с(0,3)
%! с(0,3) --перелить(второй,первый)--> с(3,0)
%! с(3,0) --налить(второй)--> с(3,3)
%! с(3,3) --перелить(второй,первый)--> с(5,1)
%! с(5,1) --вылить(первый)--> с(0,1)
%! с(0,1) --перелить(второй,первый)--> с(1,0)
%! с(1,0) --налить(второй)--> с(1,3)
%! с(1,3) --перелить(второй,первый)--> с(4,0)
%! готово: с(4,0)

% ----------------------------------------------------------------------------
% 2. Тот же поиск для другой задачи: волк, коза и капуста
% ----------------------------------------------------------------------------
% Ничего из поиска менять не нужно: добавляются только ходы и своя цель. Это и
% есть главная мысль урока - шаблон один, а задачи разные.
% Состояние здесь - берега(Слева, Справа, Где_лодка): обе стороны хранятся
% целиком, потому что ход "взять козу" надо чем-то дополнить - тем, что осталось.
% Правило безопасности проверяется только для того берега, который человек
% покидает: рядом с ним никто никого не съест.

безопасно(Берег):-НЕ(вместе(Берег, волк, коза)),
	НЕ(вместе(Берег, коза, капуста)).

вместе(Берег, Первый, Второй):-член(Первый, Берег), член(Второй, Берег).

выбрать(Элемент, [Элемент | Хвост], Хвост).
выбрать(Элемент, [Голова | Хвост], [Голова | Остаток]):-
	выбрать(Элемент, Хвост, Остаток).

ход(берега(Слева, Справа, слева), везти(Груз), берега(Осталось, [Груз | Справа], справа)):-
	выбрать(Груз, Слева, Осталось), безопасно(Осталось).
ход(берега(Слева, Справа, слева), плыть(пустая), берега(Слева, Справа, справа)):-
	безопасно(Слева).
ход(берега(Слева, Справа, справа), везти(Груз), берега([Груз | Слева], Осталось, слева)):-
	выбрать(Груз, Справа, Осталось), безопасно(Осталось).
ход(берега(Слева, Справа, справа), плыть(пустая), берега(Слева, Справа, слева)):-
	безопасно(Справа).

% Цель: левый берег пуст (значит, всё перевезено), лодка справа. Правый берег в
% проверке стоит без имени: его содержимое нас не интересует - оно получится само.
достигнута(берега([], _, справа)).

перевоз(Путь):-идти(берега([волк, коза, капуста], [], слева),
         [берега([волк, коза, капуста], [], слева)],
         Путь), !.

?ТИХО, перевоз(Ходы), шаги(берега([волк, коза, капуста], [], слева), Ходы).
%! берега([волк,коза,капуста],[],слева) --везти(коза)--> берега([волк,капуста],[коза],справа)
%! берега([волк,капуста],[коза],справа) --плыть(пустая)--> берега([волк,капуста],[коза],слева)
%! берега([волк,капуста],[коза],слева) --везти(волк)--> берега([капуста],[волк,коза],справа)
%! берега([капуста],[волк,коза],справа) --везти(коза)--> берега([коза,капуста],[волк],слева)
%! берега([коза,капуста],[волк],слева) --везти(капуста)--> берега([коза],[капуста,волк],справа)
%! берега([коза],[капуста,волк],справа) --везти(волк)--> берега([волк,коза],[капуста],слева)
%! берега([волк,коза],[капуста],слева) --везти(волк)--> берега([коза],[волк,капуста],справа)
%! берега([коза],[волк,капуста],справа) --плыть(пустая)--> берега([коза],[волк,капуста],слева)
%! берега([коза],[волк,капуста],слева) --везти(коза)--> берега([],[коза,волк,капуста],справа)
%! готово: берега([],[коза,волк,капуста],справа)

% ----------------------------------------------------------------------------
% 3. Порождение и проверка: восемь ферзей
% ----------------------------------------------------------------------------
% Второй способ перебора: строить ответ по частям и отбрасывать неудачные.
% Расставим по одной фигуре в каждую строку, проверяя каждую новую против уже
% поставленных. Так неудачные варианты отсекаются сразу.
% Между/3 - генератор чисел: ?между(1, 3, Число) выдаёт 1, 2, 3.
между(Низ, Верх, Низ):-НЕ(БОЛЬШЕ(Низ, Верх)).
между(Низ, Верх, Число):-БОЛЬШЕ(Верх, Низ), СЛОЖЕНИЕ(Низ, 1, След),
	между(След, Верх, Число).

?между(1, 3, Число).
%! Число=1
%! Число=2
%! Число=3
% Разность/3 - это модуль разности: на диагонали стоят клетки, у которых
% расстояние по строке равно расстоянию по столбцу.
разность(Первое, Второе, Разница):-НЕ(БОЛЬШЕ(Второе, Первое)), СЛОЖЕНИЕ(Разница,
	Второе, Первое), !.
разность(Первое, Второе, Разница):-СЛОЖЕНИЕ(Первое, Разница, Второе).

?разность(2, 5, Разница).
%! Разница=3
?разность(5, 2, Разница).
%! Разница=3
% Не_бьёт/3 проверяет новую фигуру против уже поставленных: по столбцу и по
% обеим диагоналям.
не_бьёт(_, _, []).
не_бьёт(Строка, Столбец, [[СтрокаУже, СтолбецУже] | Дальше]):-НЕ(РАВНО(Столбец,
	СтолбецУже)), разность(Строка, СтрокаУже, РазницаСтрок), разность(Столбец,
	СтолбецУже, РазницаСтолбцов), НЕ(РАВНО(РазницаСтрок, РазницаСтолбцов)),
	не_бьёт(Строка, Столбец, Дальше).

?не_бьёт(1, 1, [[2, 3]]).
%! ДА
?не_бьёт(1, 1, [[2, 2]]).
%! НЕТ
% Расстановка идёт снизу вверх: сначала выбираем клетку для последней строки,
% потом для предпоследней, и так до первой. Каждая проверяется против тех,
% что уже стоят ниже. Готовая доска накапливается в третьем аргументе: у него
% уже стоят нижние строки, и новая встаёт в голову - поэтому в ответе строки
% идут по порядку.
расставить(0, _, Доска, Доска):-!.
расставить(Номер, Размер, Ниже, Доска):-между(1, Размер, Столбец),
	не_бьёт(Номер, Столбец, Ниже), СЛОЖЕНИЕ(Меньше, 1, Номер),
	расставить(Меньше, Размер, [[Номер, Столбец] | Ниже], Доска).

ферзи(Размер, Доска):-расставить(Размер, Размер, [], Доска), !.

печать_доски([]).
печать_доски([[Номер, Столбец] | Дальше]):-
	ВЫВОД("строка ", Номер, " - столбец ", Столбец), ПС, печать_доски(Дальше).

?ТИХО, ферзи(8, Доска), печать_доски(Доска).
%! строка 1 - столбец 4
%! строка 2 - столбец 2
%! строка 3 - столбец 7
%! строка 4 - столбец 3
%! строка 5 - столбец 6
%! строка 6 - столбец 8
%! строка 7 - столбец 5
%! строка 8 - столбец 1

% ----------------------------------------------------------------------------
% 4. Упражнения
% ----------------------------------------------------------------------------
% 1. Что произойдёт, если из идти/3 убрать цель НЕ(член(След, История))?
% 2. Почему поиск в глубину находит какое-то решение, но не обязательно самое
%    короткое?
% 3. Сколько всего состояний у задачи о переливании?
% 4. Зачем в задаче о ферзях проверять новую фигуру против уже поставленных, а
%    не против всей доски?
% 5. Зачем нужен шаги/2, если ходы уже найдены?
% 6. Почему достигнута/1 определена двумя предложениями?
% 7. Что будет, если в задаче о перевозе убрать проверку безопасно(Осталось)?
%
% Решения:
% 1. Поиск зациклится. Из любого состояния есть ход назад - например из с(5,0)
%    можно вылить(первый) вернуться в с(0,0), а оттуда налить(первый) снова
%    получить с(5,0) - и без памяти о пройденном история будет ходить по кругу
%    без конца.
% 2. Поиск в глубину идёт по первому подходящему ходу до упора и возвращается
%    только когда зашёл в тупик. Поэтому найденный путь не обязан быть
%    кратчайшим: у переливаний ответ занял 10 ходов, хотя уложиться можно было
%    и быстрее - поиск об этом не знает.
% 3. Двадцать четыре: в первом сосуде может быть от 0 до 5 литров (6 вариантов),
%    во втором от 0 до 3 (4 варианта), 6 * 4 = 24.
% 4. Потому что так неудачные клетки отсекаются сразу: перебор всех расстановок -
%    это 8^8, то есть 16 777 216 вариантов; проверка на каждом шаге сокращает
%    его на порядки.
% 5. Шаги/2 проходит найденные ходы заново и печатает состояние после каждого.
%    Это и понятная запись решения, и его проверка: если бы путь был собран
%    неправильно, шаги/2 не сошлись бы с ходами.
% 6. Состояния у двух задач разные: с/2 у переливаний и берега/3 у перевоза.
%    Шаблон поиска общий, а цель у каждой задачи своя.
% 7. Ходы перестали бы проверять условие задачи, и поиск нашёл бы путь к цели,
%    по дороге оставив козу на одном берегу с капустой или волка с козой:
%    безопасно([волк, коза]) ложно, а без проверки это уже не мешает.
%
% ----------------------------------------------------------------------------
% Что вы теперь знаете
% ----------------------------------------------------------------------------
% * задачу перебора описывают три отношения: состояние, ход и цель (раздел 1);
% * поиск в глубину - это рекурсия по ходам, а отсечение прекращает перебор,
%   когда цель достигнута;
% * без памяти о посещённых состояниях поиск зацикливается (раздел 1);
% * один и тот же шаблон поиска годится для разных задач: меняются только
%   ход/3 и достигнута/1 (раздел 2);
% * второй способ - порождение и проверка: строим ответ по частям и отбрасываем
%   неудачные сразу (раздел 3);
% * найденный путь печатают отдельным предикатом, проходя его заново.
%
% Дальше: урок 9 - задачи на ограничениях.
