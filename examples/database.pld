% ДОБ/3 (assert), ДОБНАЧ/1,2 и ДОБКОН/1,2 (asserta, assertz), УДАЛЕНИЕ/2
% (retract), СКОЛЬКО/2, ПРЕДЛ/4 и ТЕРМ/2 - база знаний во время работы.
%
% Программа - это не только текст, прочитанный при запуске: предложения можно
% добавлять и удалять, пока она выполняется. ДОБ ставит предложение перед
% номером, а номер 1 - это начало; ДОБНАЧ и ДОБКОН делают то же без номера.
% Порядок предложений решает, в каком порядке идут решения, и его видно по
% НАЙТИВСЕ.
% ISO-имена: assert/3, asserta, assertz, retract/2; у СКОЛЬКО, ПРЕДЛ и ТЕРМ
% стандартных имён нет.
%
% Запуск:  prologd -s examples/database.pld

факт(1).

% Добавление в начало и в конец: порядок предложений - порядок решений
?ДОБНАЧ(факт(0)).
%! ДА
?ДОБКОН(факт(9)).
%! ДА
?НАЙТИВСЕ(Х, факт(Х), Порядок).
%! Х=_1
%! Порядок=[0,1,9]

% ДОБ ставит предложение перед номером: 2 - между нулём и единицей
?ДОБ(факт(5), [], 2).
%! ДА
?НАЙТИВСЕ(Х, факт(Х), Порядок2).
%! Х=_1
%! Порядок2=[0,5,1,9]

% Правило добавляется так же: голова и список целей тела.
% Переменные правила остаются не связаными
?ДОБКОН(двойной(Х, У), [СЛОЖЕНИЕ(Х, Х, У)]).
%! Х=_1
%! У=_1
?двойной(4, У).
%! У=8

% Сколько предложений у имени и что в одном из них
?СКОЛЬКО(факт, Сколько).
%! Сколько=4
?ПРЕДЛ(двойной, 1, Голова, Цели).
%! Голова=двойной(_1,_2)
%! Цели=[СЛОЖЕНИЕ(_1,_1,_2)]

% Терм и список его частей
?ТЕРМ(двойной(4, 8), Части).
%! Части=[двойной,4,8]

% Удаление по номеру: номер 1 - первое предложение имени
?УДАЛЕНИЕ(факт, 1).
%! ДА
?НАЙТИВСЕ(Х, факт(Х), Остаток).
%! Х=_1
%! Остаток=[5,1,9]

% Возврат базу не откатывает: ДОБ внутри НЕ остаётся, хотя само НЕ ложно
?НЕ(ДОБ(след(1), [], 1)).
%! НЕТ
?НАЙТИВСЕ(Х, след(Х), След).
%! Х=_1
%! След=[1]

% Те же добавления по-английски
?asserta(факт(2)).
%! ДА
?assertz(факт(3)).
%! ДА
?НАЙТИВСЕ(Х, факт(Х), Порядок3).
%! Х=_1
%! Порядок3=[2,5,1,9,3]
