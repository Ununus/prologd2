% Арифметика: факториал, сумма списка и НОД.
%
% Знаки ISO: X is Выраж связывает X с результатом выражения, Выраж1 =:= Выраж2
% сравнивает два выражения как числа, Выраж1 =\= Выраж2 спрашивает про их
% неравенство, X \= Y спрашивает про унификацию термов.
% Арифметическое выражение записывают ещё и между #...# - так его вычисляет любой
% знак или предикат, которому нужно число (раздел 3.3 руководства).
%
% Запуск:  prologd -s examples/arith.pld

факториал(0, 1):-!.
факториал(Число, Результат):-Число > 0, Меньше is Число - 1,
	факториал(Меньше, Часть), Результат is Часть * Число.

сумма([], 0).
сумма([Первый|Остальные], Всего):-сумма(Остальные, Часть),
	Всего is Часть + Первый.

нод(A, 0, A):-!.
нод(A, B, Н):-Остаток is A mod B, нод(B, Остаток, Н).

% Целые в Пролог-Д длинные, поэтому 20! считается точно
?факториал(20, Ф).
%! Ф=2432902008176640000
?факториал(5, Ф).
%! Ф=120
?сумма([1, 2, 3, 4], С).
%! С=10
?нод(12, 18, Н).
%! Н=6

% is берёт выражение без #...#: голые знаки по обе стороны
?X is 2 + 3 * 4.
%! X=14

% Выражение между #...# вычисляется там, где нужно число
?X = #2 + 3 * 4#.
%! X=14

% Целые и вещественные делятся по-разному: / даёт вещественное, // - целое
?X is 7 / 2.
%! X=3.5
?X is 7 // 2.
%! X=3

% // и rem отбрасывают дробную часть, div и mod округляют вниз, как в ISO
?X is -7 // 2.
%! X=-3
?X is -7 rem 2.
%! X=-1
?X is -7 div 2.
%! X=-4
?X is -7 mod 2.
%! X=1

% =:= спрашивает про числа: 1 и 1.0 - одно и то же число
?1 + 1 =:= 2.
%! ДА
?1 =:= 1.0.
%! ДА
?X = 2, X =:= 1 + 1.
%! X=2

% =\= - «арифметически не равно»
?3 =\= 1 + 1.
%! ДА

% \= спрашивает про унификацию термов, к арифметике он отношения не имеет
?f(a) \= f(b).
%! ДА
?2 \= 2.
%! НЕТ

% У свободной переменной X = 1 истинно всегда, поэтому \= на ней ложно
?X \= 1.
%! НЕТ
?X = молоко, X \= хлеб.
%! X=молоко

% Целое и вещественное сравниваются точно, без перевода в плавающую точку:
% 2 ** 53 + 1 и вещественное 2 ** 53 - разные числа, а 2 ** 53 и оно же - одно
?X = #2 ** 53 + 1#, Y = #2 ** 53 + 0.0#, X \= Y.
%! X=9007199254740993
%! Y=9007199254740992.0
?X = #2 ** 53#, Y = #2 ** 53 + 0.0#, X = Y.
%! X=9007199254740992
%! Y=9007199254740992.0
