% Стандартный порядок термов: знаки `@<` `@=<` `@>` `@>=` и `compare/3`.
%
% Порядок, по которому сравнивают любые термы (раздел 5.9 руководства):
% переменная, затем число, затем текст, затем составной терм; внутри вида —
% по значению, по коду символа и по арности, имени и аргументам.
%
% Запуск:  prologu -s examples/prologu/standard_order_demo.pld

пролог("Д", "Григорьев").
пролог("GNU", "Диас").
пролог("SWI", "Вилемакер").
пролог("Visual", "PDC").

% Список пар сортируется по первому элементу:
?НАЙТИВСЕ([Диалект, Автор], пролог(Диалект, Автор), Q), СОРТИРОВКА(Q, W).
%! Диалект=_1
%! Автор=_1
%! Q=[[Д,Григорьев],[GNU,Диас],[SWI,Вилемакер],[Visual,PDC]]
%! W=[[GNU,Диас],[SWI,Вилемакер],[Visual,PDC],[Д,Григорьев]]

% compare/3 называет место двух термов: <, = или >
?compare(Порядок, 1, 2).
%! Порядок=<
?compare(Порядок, 2, 1).
%! Порядок=>
?compare(Порядок, 1, 1).
%! Порядок==

% Тот же вызов с готовым ответом — проверка
?compare(<, 1, 2).
%! ДА

% Знаки спрашивают то же самое короче
?1 @< 2.
%! ДА
?1 @>= 1.
%! ДА
?ф(1) @< ф(1, 2).
%! ДА
?[а, б] @< [б].
%! ДА
?молоко @< 1.
%! НЕТ

% Числа раньше текста, текст — раньше составных, арность раньше имени
?СОРТИРОВКА([1, молоко, [а], ф(б)], С).
%! С=[1,молоко,ф(б),[а]]
