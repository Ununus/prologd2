% ПЕРВОЕ/1..n (first) — «взять первое, что получится».
%
% ПЕРВОЕ(Цель1, Цель2, ...) берёт первое решение первой цели, у которой оно есть,
% и на этом останавливается: следующие цели даже не пробуются, а откат внутрь
% взятой цели не возвращается. Так записывают «если — то — иначе»: условие и «то»
% стоят парой в скобках, «иначе» — вторым аргументом. Раньше этот предикат
% назывался ИЛИ и принимал ровно две цели (урок 4).
%
% Запуск:  prologu -s examples/first_demo.pld

цена(хлеб, 40).
цена(молоко, 20).
цена(сыр, 120).

% Первая подходящая цена: хлеб (40 меньше 50), хотя после него нашлось бы и молоко.
?ПЕРВОЕ((цена(Т, Ц), Ц < 50), Т = иначе).
%! Т=хлеб
%! Ц=40

% Ни одна цена не подошла — берётся «иначе».
?ПЕРВОЕ((цена(Т, _Ц), _Ц < 10), Т = иначе).
%! Т=иначе

% Второй аргумент не пробуется вообще: первая цель уже решилась.
?ПЕРВОЕ(цена(_Т, _Ц), ЛОЖЬ).
%! ДА

% «Если — то — иначе» целым правилом: дешёвый товар или дорогой.
категория(Т, Категория):-ПЕРВОЕ((цена(Т, Ц), Ц < 50, Категория = дешёвый),
           (цена(Т, Ц), Категория = дорогой)).

?категория(хлеб, К).
%! К=дешёвый
?категория(сыр, К).
%! К=дорогой
