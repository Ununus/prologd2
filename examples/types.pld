% ПЕР/1, ЦЕЛ/1, ВЕЩ/1, АТОМ/1, СТРОКА/1, СИМВ/1, СПИСОК/1, ПОЛНЫЙ/1 - проверки
% вида терма; СТРЦЕЛ/2, СТРВЕЩ/2, ЦЕЛВЕЩ/2, СТРСПИС/2, АТОМСТР/2 - перевод
% между видами; ЦЕЛЗНАЧ/1 и ЧИСЛЗНАЧ/1 - мягкие проверки значения.
%
% Проверка смотрит на вид вершины терма: ЦЕЛ - целое, ВЕЩ - вещественное, АТОМ -
% символьная константа, СТРОКА - текст в кавычках, СИМВ - любой текст (атом или строка),
% СПИСОК - список или [], ПОЛНЫЙ - в терме нигде нет свободных переменных.
% ЦЕЛ(5.0) ложно: 5.0 - вещественное, хотя значение целое.
% Перевод работает в обе стороны: известен один аргумент - второй получает ответ,
% известны оба - это проверка.
% ISO-имена: var, integer, float, atom, string, is_text, is_list, ground;
% str_to_int, str_to_float, int_to_float, str_to_list, atom_string; is_whole,
% is_number (разделы 5.7, 9 и 10 руководства).
%
% Запуск:  prologd -s examples/types.pld

% Число: целое и вещественное - разные виды
?ЦЕЛ(5).
%! ДА
?ЦЕЛ(5.0).
%! НЕТ
?ВЕЩ(5.0).
%! ДА
?ВЕЩ(5).
%! НЕТ

% Текст: атом и строка - разные виды, СИМВ берёт оба
?АТОМ(молоко).
%! ДА
?АТОМ("молоко").
%! НЕТ
?СТРОКА("молоко").
%! ДА
?СТРОКА(молоко).
%! НЕТ
?СИМВ(молоко).
%! ДА
?СИМВ("молоко").
%! ДА

% Пустой список - такая же константа, как атом
?АТОМ([]).
%! ДА
?СПИСОК([]).
%! ДА
?СПИСОК([1, 2]).
%! ДА
?СПИСОК("молоко").
%! НЕТ

% Чужой вид проверку не проходит
?АТОМ(5).
%! НЕТ
?СТРОКА([1]).
%! НЕТ
?СПИСОК(ф(1)).
%! НЕТ

% ПОЛНЫЙ смотрит на весь терм: переменная внутри списка считается так же
?ПОЛНЫЙ(факт(1, [2, 3])).
%! ДА
?ПОЛНЫЙ(факт(1, [2, Х])).
%! НЕТ

% Свободная переменная не проходит ни одну из них
?ПЕР(5).
%! НЕТ
?РАВНО(Х, 5), ЦЕЛ(Х).
%! Х=5

% Перевод в обе стороны: известен один аргумент - второй получает ответ
?ЦЕЛВЕЩ(3, В).
%! В=3.0
?ЦЕЛВЕЩ(Ц, 3.0).
%! Ц=3
?СТРЦЕЛ("42", Ц).
%! Ц=42
?СТРЦЕЛ(С, 42).
%! С=42
?СТРВЕЩ("2.5", В).
%! В=2.5
?СТРСПИС("аб", Коды).
%! Коды=[1072,1073]

% Атом и строка одного текста печатаются одинаково, поэтому вид ответа
% показывает проверка рядом
?АТОМСТР(молоко, С), СТРОКА(С).
%! С=молоко
?АТОМСТР(А, "молоко"), АТОМ(А).
%! А=молоко
?АТОМСТР(молоко, "молоко").
%! ДА
?АТОМСТР(молоко, "сыр").
%! НЕТ

% Мягкие проверки значения (раздел 5.7): ЦЕЛЗНАЧ и ЧИСЛЗНАЧ смотрят на само
% значение, поэтому ЦЕЛЗНАЧ(5.0) истинно, хотя ЦЕЛ(5.0) ложно
?ЦЕЛЗНАЧ(5.0).
%! ДА
?ЦЕЛЗНАЧ(5.5).
%! НЕТ
?ЧИСЛЗНАЧ(5).
%! ДА

% Те же проверки по-английски
?integer(5).
%! ДА
?float(5.0).
%! ДА
?atom(молоко).
%! ДА
?atom("молоко").
%! НЕТ
?string("молоко").
%! ДА
?is_text("молоко").
%! ДА
?is_list([1]).
%! ДА
?ground(факт(1)).
%! ДА
?atom_string(молоко, С).
%! С=молоко
?is_whole(5.0).
%! ДА