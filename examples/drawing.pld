круг(X,Y,R,C):-
	ОКРУЖНОСТЬ(X, Y, R, C),
	ЗАКРАСКА(X, Y, C).
зуб(X,Y,W,H):-
	ЛИНИЯ(X,Y,#X+W#,Y,0),
	ЛИНИЯ(X,Y,X,#Y+H#,0),
	ЛИНИЯ(#X+W#,#Y+H#,#X+W#,Y,0),
	ЛИНИЯ(#X+W#,#Y+H#,X,#Y+H#,0),
	ЗАКРАСКА(#X+1#,#Y+1#,15).
зубы(X,Y,W,H,C):-
	БОЛЬШЕ(C,0),
	зуб(X,Y,W,H),
	зубы(#X+W#,Y,W,H,#C-1#).
зубы(_,_,_,_,_):-!.
клык(X,Y,W,H):-
	ЛИНИЯ(X,Y,#X+W#,Y,15),
	ЛИНИЯ(X,Y,#X+W/2#,#Y+H#,0),
	ЛИНИЯ(#X+W#,Y,#X+W/2#,#Y+H#,0),
	ЗАКРАСКА(#X+W/2#,#Y+1#,15).
лицо:-
	круг(320,240,240,14),
	круг(220,180,40,1),
	круг(420,180,40,1),
	зубы(220,320,20,40,10),
	клык(360,360,20,20).
?ЗАКРАСКА(0,0,0),лицо.
