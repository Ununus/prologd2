% Рисунок: лицо.  Запуск в дереве исходников:
%   prologd -I stdlib -s examples/drawing.pld
% Цвета - имена из библиотеки stdlib/graphics.pld; ниже видно, как имя связывается
% с числом и передаётся дальше как обычный аргумент.

:- ХОЛСТ(500, 600).

:- ИМПОРТ("graphics.pld").

круг(X,Y,R,C):-ОКРУЖНОСТЬ(X, Y, R, C), ЗАКРАСКА(X, Y, C).
зуб(X,Y,W,H):-чёрный(Чёрный), белый(Белый), ЛИНИЯ(X,Y,#X+W#,Y,Чёрный),
	ЛИНИЯ(X,Y,X,#Y+H#,Чёрный), ЛИНИЯ(#X+W#,#Y+H#,#X+W#,Y,Чёрный),
	ЛИНИЯ(#X+W#,#Y+H#,X,#Y+H#,Чёрный), ЗАКРАСКА(#X+1#,#Y+1#,Белый).
зубы(X,Y,W,H,C):-БОЛЬШЕ(C,0), зуб(X,Y,W,H), зубы(#X+W#,Y,W,H,#C-1#).
зубы(_,_,_,_,_):-!.
клык(X,Y,W,H):-белый(Белый), чёрный(Чёрный), ЛИНИЯ(X,Y,#X+W#,Y,Белый),
	ЛИНИЯ(X,Y,#X+W//2#,#Y+H#,Чёрный), ЛИНИЯ(#X+W#,Y,#X+W//2#,#Y+H#,Чёрный),
	ЗАКРАСКА(#X+W//2#,#Y+1#,Белый).
лицо:-жёлтый(Жёлтый), синий(Синий), круг(320,240,240,Жёлтый),
	круг(220,180,40,Синий), круг(420,180,40,Синий), зубы(220,320,20,40,10),
	клык(360,360,20,20).
?лицо.
