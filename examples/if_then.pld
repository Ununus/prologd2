% ПЕРВОЕ/1..n и знак -> - выбор ветви без возврата.
%
% ПЕРВОЕ(Цель1, Цель2, ...) берёт первое решение первой цели, у которой оно
% есть, и на этом останавливается: следующие цели не пробуются, а откат внутрь
% взятой цели не возвращается. Так записывают «если - то - иначе»: условие и
% «то» стоят парой в скобках, «иначе» - вторым аргументом.
% Знак -> пишет то же в записи ISO: (Условие -> Тогда) берёт первое решение
% условия и выполняет следствие, а (Условие -> Тогда ; Иначе) добавляет ветвь
% «иначе». Знак слабее запятой и сильнее ;.
% Знаки -> и ; стандартные; ПЕРВОЕ - предикат диалекта, в ISO его нет.
% Подробности - в руководстве, разделы 4.5 и 4.6.
%
% Запуск:  prologd -s examples/if_then.pld

цена(хлеб, 40).
цена(молоко, 20).
цена(сыр, 120).

% Первая подходящая цена: хлеб, хотя после него нашлось бы и молоко
?ПЕРВОЕ((цена(Т, Ц), Ц < 50), Т = иначе).
%! Т=хлеб
%! Ц=40

% Ни одна цена не подошла - берётся «иначе»
?ПЕРВОЕ((цена(Т, _Ц), _Ц < 10), Т = иначе).
%! Т=иначе

% Второй аргумент не пробуется вовсе: первая цель уже решилась
?ПЕРВОЕ(цена(_Т, _Ц), ЛОЖЬ).
%! ДА

% «Если - то - иначе» целым правилом: дешёвый товар или дорогой
категория(Т, Категория):-ПЕРВОЕ((цена(Т, Ц), Ц < 50, Категория = дешёвый),
           (цена(Т, Ц), Категория = дорогой)).

?категория(хлеб, К).
%! К=дешёвый
?категория(сыр, К).
%! К=дорогой

% Знак ->: первое решение условия (хлеб, 40), и только оно
?цена(Т, Ц) -> Ц < 50.
%! Т=хлеб
%! Ц=40

% Условие решилось, а следствие нет - и всё же неудача
?цена(Т, Ц) -> Ц < 30.
%! НЕТ

% Условие - вся пара, поэтому перебор идёт дальше, до молока
?(цена(Т, Ц), Ц < 30) -> 1 = 1.
%! Т=молоко
%! Ц=20

% Условие решилось - сыр дороже 100, - поэтому ветвь «иначе» не берётся
?(цена(Т, Ц), Ц > 100) -> Товар = Т ; Товар = иначе.
%! Т=сыр
%! Ц=120
%! Товар=сыр

% Такого товара нет, условие не решилось - берётся «иначе»
?(цена(_Т, Ц), Ц > 200) -> Товар = дорого ; Товар = иначе.
%! Ц=_1
%! Товар=иначе

% Скобки решают: условием была одна цена, и она решилась, поэтому «иначе» не
% берётся
?(цена(Т, Ц) -> Ц > 100 ; Т = иначе).
%! НЕТ

% Знаком -> выбор пишется одним предложением
?(цена(Т, Ц), Ц < 30) -> Слово = дешёвое ; Слово = дорогое.
%! Т=молоко
%! Ц=20
%! Слово=дешёвое

% Правило: дешёвое - то, у чего цена меньше 30
дешёвое(Т):-(цена(Т, Ц), Ц < 30 -> 1 = 1).

?дешёвое(Т).
%! Т=молоко
